+import { useCallback, useMemo, useState } from 'react';
+
+type SessionSelection = {
+  experimentId: string;
+  ids: ReadonlySet<string>;
+};
+
+export const useSessionSelection = (experimentId: string, visibleSessionIds: ReadonlySet<string>, enabled = true) => {
+  const [selection, setSelection] = useState<SessionSelection>(() => ({ experimentId, ids: new Set<string>() }));
+  const selectedSessionIds = useMemo<ReadonlySet<string>>(
+    () => (selection.experimentId === experimentId ? selection.ids : new Set<string>()),
+    [experimentId, selection],
+  );
+  const visibleSelectedCount = useMemo(
+    () => [...visibleSessionIds].filter((id) => selectedSessionIds.has(id)).length,
+    [visibleSessionIds, selectedSessionIds],
+  );
+  const toggleSession = useCallback(
+    (sessionId: string) => {
+      if (!enabled) return;
+      setSelection((current) => {
+        const ids = new Set(current.experimentId === experimentId ? current.ids : []);
+        if (ids.has(sessionId)) ids.delete(sessionId);
+        else ids.add(sessionId);
+        return { experimentId, ids };
+      });
+    },
+    [experimentId, enabled],
+  );
+  const toggleVisibleSessions = useCallback(() => {
+    if (!enabled || visibleSessionIds.size === 0) return;
+    setSelection((current) => {
+      const ids = new Set(current.experimentId === experimentId ? current.ids : []);
+      const remove = [...visibleSessionIds].every((id) => ids.has(id));
+      for (const id of visibleSessionIds) {
+        if (remove) ids.delete(id);
+        else ids.add(id);
+      }
+      return { experimentId, ids };
+    });
+  }, [experimentId, visibleSessionIds, enabled]);
+  const clear = useCallback(() => setSelection({ experimentId, ids: new Set<string>() }), [experimentId]);
+
+  return { selectedSessionIds, visibleSelectedCount, toggleSession, toggleVisibleSessions, clear };
+};

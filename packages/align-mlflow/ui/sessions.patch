+): Promise<Record<string, string>> => {
+  const names: Record<string, string> = {};
+  const experimentIds = locations.flatMap((location) =>
+    location.type === 'MLFLOW_EXPERIMENT' && location.mlflow_experiment?.experiment_id
+      ? [location.mlflow_experiment.experiment_id]
+      : [],
+  );
+  for (let offset = 0; offset < runIds.length; offset += 1000) {
+    const ids = runIds.slice(offset, offset + 1000).map((id) => `'${id.replace(/'/g, "''")}'`);
+    const response = (await fetchAPI(
+      getAjaxUrl('ajax-api/2.0/mlflow/runs/search'),
+      'POST',
+      { experiment_ids: experimentIds, filter: `run_id IN (${ids.join(',')})`, max_results: 1000 },
+      signal,

+      }}
+    >
+      <div
+        css={{
+          padding: theme.spacing.md,
+          display: 'flex',
+          flexDirection: 'column',
+          gap: theme.spacing.sm,
+          borderBottom: `1px solid ${theme.colors.border}`,
+        }}
+      >
+        <Typography.Title level={3} withoutMargins>
+          {sessionLabel}
+        </Typography.Title>
+        <Link
+          componentId="mlflow.session-comparison.open-session"
+          to={Routes.getExperimentPageTabSingleChatSessionRoute(experimentId, sessionId)}
+        >
+          {sessionId}
+        </Link>
+        {isLoading ? (
+          <div role="status">Loading the complete decision sequence…</div>
+        ) : error || !complete ? (
+          <div role="alert">
+            Could not load the complete session.{' '}
+            {error instanceof Error ? error.message : String(error ?? 'Some traces are unavailable')}
+            <Button componentId="mlflow.session-comparison.retry" onClick={retry}>
+              Retry
+            </Button>
+          </div>
+        ) : infos.length === 0 ? (
+          <div>No traces found for this session.</div>
+        ) : (
+          <>
+            <dl
+              css={{
+                margin: 0,
+                display: 'grid',
+                gridTemplateColumns: 'max-content minmax(0, 1fr)',
+                gap: `${theme.spacing.xs}px ${theme.spacing.sm}px`,
+                '& dt': { fontWeight: 600 },
+                '& dd': { margin: 0, overflowWrap: 'anywhere' },
+              }}
+            >
+              {metadata.map(([label, key]) => (
+                <div key={key} css={{ display: 'contents' }}>
+                  <dt>{label}</dt>
+                  <dd>{[...new Set(infos.map((info) => info.tags?.[key] || 'Not recorded'))].join(', ')}</dd>
+                </div>
+              ))}
+              <dt>Decisions</dt>
+              <dd>{infos.length}</dd>
+            </dl>
+            {sourceRunIds.map((runId) => (

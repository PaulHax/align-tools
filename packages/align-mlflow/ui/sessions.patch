+import { describe, expect, jest, test } from '@jest/globals';
+import { fireEvent, screen, within } from '@testing-library/react';
+import { useState } from 'react';
+import { TracesTable, type TracesTableProps } from '@databricks/web-shared/traces-table/TracesTable';
+import { renderWithProviders } from '@databricks/web-shared/traces-table/test-utils/renderWithProviders';
+import { SESSION_ID_METADATA_KEY, type ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+import { useTracesV4CustomColumns } from '../hooks/useTracesV4CustomColumns';
+import { SESSION_SCORE_COLUMN_ID, SESSION_TARGET_COLUMN_ID } from '../utils/customColumns';
+import { makeFeedbackAssessment, makeSessionTrace } from '../test-utils/mockTraces';
+
+const resultTrace = (session: string, value?: number, evaluatedTarget = 'evaluated-target'): ModelTraceInfoV3 => ({
+  ...makeSessionTrace(`trace-${session}`, session),
+  tags: { alignment_target_id: 'requested-target', adm: 'regression', step: '1' },
+  assessments:
+    value === undefined
+      ? []
+      : [
+          makeFeedbackAssessment('ta3_session_alignment_score', value, {
+            source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+            metadata: { [SESSION_ID_METADATA_KEY]: session, alignment_target_id: evaluatedTarget },
+          }),
+        ],
+});
+
+const ResultTable = ({
+  traces,
+  partial = false,
+  grouped = true,
+}: {
+  traces: ModelTraceInfoV3[];
+  partial?: boolean;
+  grouped?: boolean;
+}) => {
+  const [visibility, setVisibility] = useState<Record<string, boolean>>({
+    [SESSION_SCORE_COLUMN_ID]: true,
+    [SESSION_TARGET_COLUMN_ID]: true,
+    'tag:alignment_target_id': true,
+  });
+  const customColumns = useTracesV4CustomColumns(traces, visibility, setVisibility, grouped);
+  const props: TracesTableProps = {
+    traces,
+    visibleColumns: ['session', 'input'],
+    initialColumnSizing: {},
+    onColumnSizingSettled: jest.fn(),
+    isLoading: false,
+    isFetching: false,
+    skeletonRowCount: 1,
+    onTraceSelected: jest.fn(),
+    selectedForBulk: new Map(),
+    isAllOnPageSelected: false,
+    isSomeOnPageSelected: false,
+    onToggleBulkRow: jest.fn(),
+    onToggleBulkAll: jest.fn(),
+    sort: 'start_time',
+    dir: 'desc',
+    onSort: jest.fn(),
+    onHideColumn: jest.fn(),
+    isGroupedBySession: grouped,
+    sessionsMayBeIncomplete: partial,
+    extraColumns: customColumns.columnDefs,
+  };
+  return <TracesTable {...props} />;
+};
+
+describe('recorded session result columns', () => {
+  test.each([false, true])(
+    'renders zero, missing scores and evaluated targets in session headers (partial: %s)',
+    async (partial) => {
+      await renderWithProviders(
+        <ResultTable
+          traces={[resultTrace('zero', 0), resultTrace('scored', 0.625), resultTrace('missing')]}
+          partial={partial}
+        />,
+      );
+      expect(screen.getByRole('columnheader', { name: 'TA3 alignment score' })).toBeInTheDocument();
+      expect(screen.getByRole('columnheader', { name: 'TA3 evaluated target' })).toBeInTheDocument();
+      const zeroRow = screen
+        .getByRole('button', { name: 'Expand session zero' })
+        .closest('[role="row"]') as HTMLElement;
+      expect(within(zeroRow).getByText('0')).toBeInTheDocument();
+      expect(within(zeroRow).getByText('evaluated-target')).toBeInTheDocument();
+      expect(within(zeroRow).getByText('requested-target')).toBeInTheDocument();
+      expect(screen.getByText('0.625')).toBeInTheDocument();
+      const missingRow = screen
+        .getByRole('button', { name: 'Expand session missing' })
+        .closest('[role="row"]') as HTMLElement;
+      expect(within(missingRow).getAllByText('Unavailable')).toHaveLength(2);
+      fireEvent.click(screen.getByRole('button', { name: 'Expand session zero' }));
+      expect(screen.getAllByText('0')).toHaveLength(1);
+      expect(screen.getAllByText('evaluated-target')).toHaveLength(2);
+    },
+  );
+
+  test('shows unavailable when the current page lacks the scored first trace', async () => {
+    const laterTrace = { ...resultTrace('partial'), tags: { step: '2' } };
+    await renderWithProviders(<ResultTable traces={[laterTrace]} partial />);
+    expect(screen.getAllByText('Unavailable')).toHaveLength(2);
+  });
+
+  test('does not expose session result columns on individual actions', async () => {
+    await renderWithProviders(<ResultTable traces={[resultTrace('zero', 0)]} grouped={false} />);
+    expect(screen.queryByRole('columnheader', { name: 'TA3 alignment score' })).not.toBeInTheDocument();
+    expect(screen.queryByText('evaluated-target')).not.toBeInTheDocument();
+  });
+
+  test('does not use invalid, trace-level or another session feedback', async () => {
+    const trace = resultTrace('unscored');
+    trace.assessments = [
+      makeFeedbackAssessment('ta3_session_alignment_score', 0.8, {
+        source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+        valid: false,
+        metadata: { [SESSION_ID_METADATA_KEY]: 'unscored' },
+      }),
+      makeFeedbackAssessment('ta3_session_alignment_score', 0.9, {
+        source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+      }),
+      makeFeedbackAssessment('ta3_session_alignment_score', 1, {
+        source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+        metadata: { [SESSION_ID_METADATA_KEY]: 'another' },
+      }),
+    ];
+    await renderWithProviders(<ResultTable traces={[trace]} />);
+    expect(screen.getAllByText('Unavailable')).toHaveLength(2);
+  });
+  test('keeps recorded zero when later feedback comes from a person or has no numeric TA3 score', async () => {
+    const trace = resultTrace('zero', 0);
+    const metadata = { [SESSION_ID_METADATA_KEY]: 'zero', alignment_target_id: 'other-target' };
+    const last_update_time = '2025-01-02T00:00:00.000Z';
+    trace.assessments = [
+      ...(trace.assessments ?? []),
+      makeFeedbackAssessment('ta3_session_alignment_score', 0.9, {
+        source: { source_type: 'HUMAN', source_id: 'reviewer' },
+        metadata,
+        last_update_time,
+      }),
+      makeFeedbackAssessment('ta3_session_alignment_score', 0.8, {
+        source: { source_type: 'CODE', source_id: 'different.log' },
+        metadata,
+        last_update_time,
+      }),
+      ...['unavailable', true, Number.POSITIVE_INFINITY].map((value) =>
+        makeFeedbackAssessment('ta3_session_alignment_score', value, {
+          source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+          metadata,
+          last_update_time,
+        }),
+      ),
+    ];
+    await renderWithProviders(<ResultTable traces={[trace]} />);
+    expect(screen.getByText('0')).toBeInTheDocument();
+    expect(screen.getByText('evaluated-target')).toBeInTheDocument();
+    expect(screen.queryByText('other-target')).not.toBeInTheDocument();
+  });
+
+  test.each([false, true])(
+    'breaks equal update times by assessment ID regardless of input order (%s)',
+    async (reverse) => {
+      const trace = resultTrace('tie');
+      const scores = [
+        makeFeedbackAssessment('ta3_session_alignment_score', 0.25, {
+          assessment_id: 'a-1',
+          source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+          metadata: { [SESSION_ID_METADATA_KEY]: 'tie', alignment_target_id: 'older-target' },
+        }),
+        makeFeedbackAssessment('ta3_session_alignment_score', 0.75, {
+          assessment_id: 'a-2',

+import { FilterOp, type FilterClause, type TraceFilterModel } from '@databricks/web-shared/traces-table';
+import type { OpenWorldEpisode } from './openWorldResultsData';
+
+export const SESSION_FILTER_PARAM = 'resultsSessionFilters';
+
+const dimensions = [
+  ['runId', 'metadata', 'mlflow.sourceRun'],
+  ['scenario', 'tag', 'scenario_id'],
+  ['target', 'tag', 'alignment_target_id'],
+  ['adm', 'tag', 'adm'],
+  ['model', 'tag', 'llm'],
+  ['driver', 'tag', 'align.driver'],
+  ['sourceVersion', 'tag', 'align.source_version'],
+  ['sourceFamily', 'tag', 'align.source_family'],
+] as const;
+
+/** Only add extra configuration fields when they distinguish otherwise identical runs. */
+export const filtersForEpisodes = (
+  members: OpenWorldEpisode[],
+  cohort: OpenWorldEpisode[],
+  scope: 'row' | 'column' | 'cell' | 'episodes' = 'episodes',
+): { filters: TraceFilterModel; exactSelection: boolean } => {
+  const filters: TraceFilterModel = [];
+  let candidates = cohort;
+  const ids = new Set(members.map(({ id }) => id));
+  const isExact = () => candidates.length === ids.size && candidates.every(({ id }) => ids.has(id));
+  if (!members.length) return { filters, exactSelection: true };
+  for (const [property, field, key] of dimensions) {
+    if (scope === 'row' && !['scenario', 'target'].includes(property)) continue;
+    if (scope === 'column' && ['scenario', 'target'].includes(property)) continue;
+    const value = members[0][property];
+    if (!value || !members.every((member) => member[property] === value)) continue;
+    if (filters.length >= 1 && isExact() && !['runId', 'scenario', 'target'].includes(property)) break;
+    filters.push({ field, key, operator: FilterOp.EQUALS, value });
+    candidates = candidates.filter((episode) => episode[property] === value);
+  }
+  if (scope === 'episodes' && members.length === 1 && members[0].sessionId) {
+    filters.push({ field: 'session', operator: FilterOp.EQUALS, value: members[0].sessionId });
+    candidates = candidates.filter((episode) => episode.sessionId === members[0].sessionId);
+  }
+  return { filters, exactSelection: !isExact() };
+};
+
+export const readSessionFilterModel = (value: string): TraceFilterModel => {
+  const clauses: unknown = JSON.parse(value);
+  if (
+    !Array.isArray(clauses) ||
+    !clauses.every((clause: unknown): clause is FilterClause => {
+      if (!clause || typeof clause !== 'object') return false;
+      const item = clause as Record<string, unknown>;
+      return (
+        typeof item['field'] === 'string' &&
+        typeof item['value'] === 'string' &&
+        Object.values(FilterOp).includes(item['operator'] as FilterOp) &&
+        (item['key'] === undefined || typeof item['key'] === 'string')
+      );
+    })
+  ) {
+    throw new Error('The session filters in this URL are invalid. Clear them to show all dashboard sessions.');
+  }
+  return clauses;
+};

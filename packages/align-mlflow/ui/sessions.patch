+const evaluation = (traceInfo: ModelTraceInfoV3): RunEvaluationTracesDataEntry => ({
+  evaluationId: traceInfo.trace_id,
+  requestId: traceInfo.trace_id,
+  inputsId: traceInfo.trace_id,
+  inputs: {},
+  outputs: {},
+  targets: {},
+  overallAssessments: [],
+  responseAssessmentsByName: {},
+  metrics: {},

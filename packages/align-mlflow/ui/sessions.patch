+        >
+          {sessionId}
+        </Link>
+        {isLoading ? (
+          <div role="status">Loading the complete decision sequence…</div>
+        ) : error || !complete ? (
+          <div role="alert">
+            Could not load the complete session.{' '}
+            {error instanceof Error ? error.message : String(error ?? 'Some traces are unavailable')}
+            <Button componentId="mlflow.session-comparison.retry" onClick={retry}>

+      const previous = latest.get(key);
+      const recency = previous
+        ? Date.parse(assessment.last_update_time) - Date.parse(previous.last_update_time) ||
+          assessment.assessment_id.localeCompare(previous.assessment_id)
+        : 1;
+      if (recency > 0) latest.set(key, assessment);
+    }

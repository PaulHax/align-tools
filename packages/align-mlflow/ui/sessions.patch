+import { useMemo } from 'react';
+import { createTraceLocationForExperiment } from '@databricks/web-shared/genai-traces-table';
+import { SESSION_ID_METADATA_KEY } from '@databricks/web-shared/model-trace-explorer';
+import type { TraceFilterModel } from '@databricks/web-shared/traces-table';
+import { useQuery } from '../../../common/utils/reactQueryHooks';
+import { fetchTracesV4SortPopulation } from '../../components/experiment-page/components/traces-v4/utils/fetchTracesV4Population';
+import { compileFilterModel } from '../../components/experiment-page/components/traces-v4/utils/filterModel';
+import type { OpenWorldEpisode } from './openWorldResultsData';
+
+type SessionFilterMatches = { sessionIds: string[]; traceIds: string[] };
+
+type Props = {
+  experimentId: string;
+  episodes: OpenWorldEpisode[];
+  filters: TraceFilterModel;
+};
+
+export const fetchOpenWorldSessionFilterMatches = async (
+  experimentId: string,
+  filter: string,
+  signal?: AbortSignal,
+): Promise<SessionFilterMatches> => {
+  const sessionIds = new Set<string>();
+  const traceIds = new Set<string>();
+  const traces = await fetchTracesV4SortPopulation([createTraceLocationForExperiment(experimentId)], filter, signal);
+  for (const trace of traces) {
+    const sessionId = trace.trace_metadata?.[SESSION_ID_METADATA_KEY];
+    if (sessionId) sessionIds.add(sessionId);
+    else traceIds.add(trace.trace_id);
+  }
+  return { sessionIds: [...sessionIds], traceIds: [...traceIds] };
+};
+
+export const useOpenWorldSessionFilters = ({ experimentId, episodes, filters }: Props) => {
+  const filter = compileFilterModel(filters).join(' AND ');
+  const cohortFingerprint = useMemo(
+    () =>
+      JSON.stringify(
+        episodes
+          .map((episode) => ({ id: episode.id, sessionId: episode.sessionId, traces: episode.traces }))
+          .sort((left, right) => left.id.localeCompare(right.id)),
+      ),
+    [episodes],
+  );
+  const enabled = Boolean(experimentId && filter && episodes.length);
+  const query = useQuery({
+    queryKey: ['open-world-session-filter-matches', experimentId, filter, cohortFingerprint],
+    queryFn: ({ signal }) => fetchOpenWorldSessionFilterMatches(experimentId, filter, signal),
+    enabled,
+    retry: false,
+    keepPreviousData: false,
+    staleTime: 0,
+    refetchOnMount: true,
+    refetchOnWindowFocus: true,
+  });
+  const matchingEpisodes = useMemo(() => {
+    if (!filter) return episodes;
+    if (!enabled || !query.data || query.isError) return [];
+    const sessionIds = new Set(query.data.sessionIds);
+    const traceIds = new Set(query.data.traceIds);
+    return episodes.filter((episode) =>
+      episode.sessionId
+        ? sessionIds.has(episode.sessionId)
+        : traceIds.has(episode.traceId) || episode.traces.some((trace) => traceIds.has(trace.trace_id)),
+    );
+  }, [episodes, filter, enabled, query.data, query.isError]);
+  return {
+    episodes: matchingEpisodes,
+    isLoading: enabled && query.isLoading,
+    isRefreshing: enabled && query.isFetching && !query.isLoading,
+    error: enabled ? query.error : null,
+    refetch: query.refetch,
+  };
+};

+    trace_id: `${sessionId}-step-${index}`,
+    trace_location: { type: 'MLFLOW_EXPERIMENT', mlflow_experiment: { experiment_id: 'exp-1' } },
+    request_time: `2026-10-24T12:00:0${index}.000Z`,
+    request_preview: `${sessionId} action ${index}`,
+    state: 'OK',
+    tags: { 'align.run_key': sessionId, scenario_id: scenario, alignment_target_id: target },
+    trace_metadata: { [SESSION_ID_METADATA_KEY]: sessionId },
+  }));

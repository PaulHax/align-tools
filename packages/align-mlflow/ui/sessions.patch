+type Props = {
+  locations: ModelTraceSearchLocation[];
+  filter?: string;
+  sort: string;
+  direction: SortDirection;
+  isGroupedBySession: boolean;
+  sessionsMayBeIncomplete?: boolean;
+  pageIndex: number;
+  pageSize: number;
+  enabled: boolean;
+  onPageIndexChange: (next: number) => void;
+};

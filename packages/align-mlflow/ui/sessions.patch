+/** Sort the complete matching population before selecting a page of traces or whole session groups. */
+export const useTracesV4SortedPage = ({
+  locations,
+  filter,
+  sort,
+  direction,
+  isGroupedBySession,
+  sessionsMayBeIncomplete = false,
+  pageIndex,
+  pageSize,
+  enabled,
+  onPageIndexChange,

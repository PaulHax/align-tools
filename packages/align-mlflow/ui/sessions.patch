+import {
+  SESSION_ID_METADATA_KEY,
+  getAssessmentValue,
+  type ModelTraceInfoV3,
+} from '@databricks/web-shared/model-trace-explorer';
+import { recordedSessionScore } from '../../components/experiment-page/components/traces-v4/utils/sessionResults';
+
+export type OpenWorldEpisode = {
+  id: string;
+  sessionId: string;
+  traceId: string;
+  traces: ModelTraceInfoV3[];
+  runId: string;
+  runName: string;
+  adm: string;
+  model: string;
+  scenario: string;
+  target: string;
+  evaluatedTarget: string;
+  alignmentMode?: string;
+  sourceVersion: string;
+  sourceFamily: string;
+  scoringVersion: string;
+  driver: string;
+  score: number | undefined;
+  targetMismatch: boolean;
+  metadataConflicts: string[];
+  compatibilityKey: string;
+};
+
+const fieldTags = {
+  runName: 'run',
+  adm: 'adm',
+  model: 'llm',
+  scenario: 'scenario_id',
+  target: 'alignment_target_id',
+  sourceVersion: 'align.source_version',
+  sourceFamily: 'align.source_family',
+  driver: 'align.driver',
+  alignmentMode: 'align.alignment_mode',
+} as const;
+
+export const buildOpenWorldEpisodes = (traces: ModelTraceInfoV3[]): OpenWorldEpisode[] => {
+  const sessions = new Map<string, ModelTraceInfoV3[]>();
+  traces
+    .filter((trace) => trace.tags?.['step'] === '1' && trace.tags?.['align.import_complete'] === 'source-record-v1')
+    .forEach((trace) => {
+      const id = trace.trace_metadata?.[SESSION_ID_METADATA_KEY] || `trace:${trace.trace_id}`;
+      sessions.set(id, [...(sessions.get(id) ?? []), trace]);
+    });
+  return [...sessions.entries()]
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([id, members]) => {
+      const ordered = [...members].sort((a, b) => a.trace_id.localeCompare(b.trace_id));
+      const metadataConflicts: string[] = [];
+      const read = (field: string, values: string[]) => {
+        const unique = [...new Set(values)];
+        if (unique.length > 1) metadataConflicts.push(field);
+        return unique.length === 1 ? unique[0] : '';
+      };
+      const fields = Object.fromEntries(
+        Object.entries(fieldTags).map(([field, tag]) => [
+          field,
+          read(
+            field,
+            ordered.map((trace) => trace.tags?.[tag] ?? ''),
+          ),
+        ]),
+      ) as Pick<OpenWorldEpisode, keyof typeof fieldTags>;
+      const sessionId = ordered[0].trace_metadata?.[SESSION_ID_METADATA_KEY] ?? '';
+      if (!sessionId) metadataConflicts.push('sessionId');
+      const runId = read(
+        'runId',
+        ordered.map((trace) => trace.trace_metadata?.['mlflow.sourceRun'] ?? ''),
+      );
+      const assessment = recordedSessionScore(ordered, sessionId);
+      const value = assessment && getAssessmentValue(assessment);
+      const evaluatedTarget = assessment?.metadata?.['alignment_target_id'] ?? '';
+      const scoringVersion = assessment?.metadata?.['scoring_version'] ?? '';
+      const compatibilityKey = JSON.stringify([fields.sourceFamily, fields.sourceVersion, scoringVersion]);
+      return {
+        ...fields,
+        id,
+        sessionId,
+        runId,
+        traceId: ordered[0].trace_id,
+        traces: ordered,
+        evaluatedTarget,
+        scoringVersion,
+        score: typeof value === 'number' ? value : undefined,
+        targetMismatch: Boolean(fields.target && evaluatedTarget && fields.target !== evaluatedTarget),
+        metadataConflicts,
+        compatibilityKey,
+      };
+    });
+};
+
+export const episodeCaseTarget = (episode: OpenWorldEpisode) =>
+  episode.score === undefined ? episode.target : episode.evaluatedTarget;
+
+export const episodeCaseKey = (episode: OpenWorldEpisode) =>
+  episode.score !== undefined && (!episode.scenario || !episode.evaluatedTarget)
+    ? JSON.stringify(['unknown-evaluated-case', episode.id])
+    : JSON.stringify([
+        episode.scenario,
+        episode.score === undefined ? 'requested' : 'evaluated',
+        episodeCaseTarget(episode),
+      ]);
+
+export const requestedTargetLabel = (episode: OpenWorldEpisode) =>
+  episode.target || (episode.alignmentMode === 'unaligned' ? 'Unaligned (no requested target)' : 'No requested target');
+
+export type EpisodeWeighting = 'episode' | 'equal-case';
+export const aggregateEpisodes = (episodes: OpenWorldEpisode[], weighting: EpisodeWeighting = 'episode') => {
+  const scored = episodes.filter((episode) => episode.score !== undefined);
+  const cases = new Map<string, number[]>();
+  scored.forEach((episode) => {
+    const key = JSON.stringify([episode.compatibilityKey, episodeCaseKey(episode)]);
+    cases.set(key, [...(cases.get(key) ?? []), episode.score as number]);
+  });
+  const meanUnavailableReason =
+    weighting === 'equal-case' && scored.some((episode) => !episode.scenario || !episode.evaluatedTarget)
+      ? 'Mean unavailable: a scored episode has no recorded scenario or evaluated target.'
+      : undefined;
+  const values =
+    weighting === 'episode'
+      ? scored.map((episode) => episode.score as number)
+      : [...cases.values()].map((scores) => scores.reduce((sum, value) => sum + value, 0) / scores.length);
+  return {
+    episodes,
+    total: episodes.length,
+    scored: scored.length,
+    missing: episodes.length - scored.length,
+    mismatches: episodes.filter((episode) => episode.targetMismatch).length,
+    mean:
+      values.length && !meanUnavailableReason
+        ? values.reduce((sum, value) => sum + value, 0) / values.length
+        : undefined,
+    meanUnavailableReason,
+  };
+};
+
+export const groupEpisodes = (
+  episodes: OpenWorldEpisode[],
+  fields: (keyof OpenWorldEpisode)[],
+  weighting: EpisodeWeighting = 'episode',
+) => {
+  const groups = new Map<string, OpenWorldEpisode[]>();
+  episodes.forEach((episode) => {
+    const key = JSON.stringify(fields.map((field) => episode[field]));
+    groups.set(key, [...(groups.get(key) ?? []), episode]);
+  });
+  return [...groups.entries()]
+    .sort(([a], [b]) => a.localeCompare(b))
+    .map(([key, members]) => ({
+      key,
+      label: fields.map((field) => members[0][field] || 'Unknown').join(' / '),
+      ...aggregateEpisodes(members, weighting),
+    }));
+};
+
+export type EpisodeFilters = Partial<
+  Record<'adm' | 'model' | 'scenario' | 'target' | 'runId' | 'sourceVersion' | 'compatibilityKey', string>
+>;
+export const filterEpisodes = (episodes: OpenWorldEpisode[], filters: EpisodeFilters) =>
+  episodes.filter((episode) =>
+    Object.entries(filters).every(
+      ([field, value]) => value === undefined || episode[field as keyof EpisodeFilters] === value,
+    ),
+  );

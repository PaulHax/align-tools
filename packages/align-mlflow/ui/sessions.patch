+import type { ModelTraceInfoV3, ModelTraceSearchLocation } from '@databricks/web-shared/model-trace-explorer';
+import { fetchAPI, getAjaxUrl } from '@databricks/web-shared/model-trace-explorer/ModelTraceExplorer.request.utils';
+
+type SearchResponse = {
+  traces?: ModelTraceInfoV3[];
+  next_page_token?: string;
+  error_code?: string;
+  message?: string;
+};
+
+export const fetchTracesV4SortPopulation = async (
+  locations: ModelTraceSearchLocation[],
+  filter: string | undefined,
+  signal?: AbortSignal,
+): Promise<ModelTraceInfoV3[]> => {
+  const traces = new Map<string, ModelTraceInfoV3>();
+  const tokens = new Set<string>();
+  let token: string | undefined;
+  do {
+    if (signal?.aborted) throw new DOMException('Trace sorting was cancelled', 'AbortError');
+    const response = (await fetchAPI(
+      getAjaxUrl('ajax-api/3.0/mlflow/traces/search'),
+      'POST',
+      {
+        locations,
+        filter,
+        max_results: 500,
+        ...(token ? { page_token: token } : {}),
+      },
+      signal,
+    )) as SearchResponse;
+    if (signal?.aborted) throw new DOMException('Trace sorting was cancelled', 'AbortError');
+    if (response.error_code) throw new Error(response.message || response.error_code);
+    if (
+      (response.traces !== undefined &&
+        (!Array.isArray(response.traces) ||
+          response.traces.some((trace) => !trace || typeof trace.trace_id !== 'string'))) ||
+      (response.next_page_token !== undefined && typeof response.next_page_token !== 'string')
+    ) {
+      throw new Error('Trace search returned an invalid response');
+    }
+    for (const trace of response.traces ?? []) traces.set(trace.trace_id, trace);
+    token = response.next_page_token || undefined;
+    if (token && tokens.has(token)) throw new Error('Trace search repeated a page token');
+    if (token) tokens.add(token);
+  } while (token);
+  return [...traces.values()];
+};

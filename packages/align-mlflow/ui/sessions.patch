+  experimentId: string;
+  sessionId: string;
+  position: number;
+  selected?: SessionChoice;
+  onSelect: (position: number, choice: SessionChoice | undefined) => void;
+}) => {
+  const { theme } = useDesignSystemTheme();
+  const side = position === 0 ? 'Left' : position === 1 ? 'Right' : `Session ${position + 1}`;
+  const sessionLabel = position < 2 ? `${side} session` : side;
+  const chatRefs = useRef<{ [traceId: string]: HTMLDivElement }>({});
+  const navigate = useNavigate();
+  const locations = useMemo(() => [createTraceLocationForExperiment(experimentId)], [experimentId]);
+  const filters = useMemo(() => getChatSessionsFilter({ sessionId }), [sessionId]);
+  const search = useSearchMlflowTraces({
+    locations,
+    filters,
+    disabled: false,
+    limit: Infinity,
+    enablePagination: false,
+  });
+  const infos = useMemo(() => orderSessionTraces(search.data ?? []), [search.data]);
+  const loadingInfos = search.isLoading || search.isFetching;
+  const queries = useQueries({
+    queries: infos.map((info) => ({
+      queryKey: ['getTrace', info.trace_id],
+      queryFn: async () => {
+        const trace = await getTrace(info.trace_id, info);
+        if (!trace) throw new Error(`Trace ${info.trace_id} is unavailable`);
+        return trace;
+      },
+      enabled: !loadingInfos && !search.error,
+      refetchOnWindowFocus: false,
+      retry: false,
+    })),
+  });
+  const error = search.error || queries.find((query) => query.error)?.error;
+  const isLoading = loadingInfos || queries.some((query) => query.isLoading || query.isFetching);
+  const traces = queries.flatMap((query) => (query.data ? [query.data] : []));
+  const complete = !isLoading && !error && traces.length === infos.length;
+  const selectedIndex =
+    selected?.sessionId === sessionId && selected.experimentId === experimentId
+      ? infos.findIndex((info) => info.trace_id === (selected.trace.info as ModelTraceInfoV3).trace_id)

+type SessionChoice = { experimentId: string; sessionId: string; trace: ModelTrace };
+
+const traceRoute = (experimentId: string, traceId: string) => ({
+  pathname: Routes.getExperimentPageTracesTabRoute(experimentId),
+  search: `?${new URLSearchParams({ [SELECTED_TRACE_ID_QUERY_PARAM]: traceId })}`,
+});
+
+const orderSessionTraces = (traces: ModelTraceInfoV3[]) => {
+  const hasSteps = traces.every((trace) => /^[1-9]\d*$/.test(trace.tags?.['step'] ?? ''));
+  return [...traces].sort(
+    (left, right) =>
+      (hasSteps ? Number(left.tags['step']) - Number(right.tags['step']) : 0) ||
+      left.request_time.localeCompare(right.request_time) ||
+      left.trace_id.localeCompare(right.trace_id),
+  );
+};
+
+const sessionScores = (traces: ModelTraceInfoV3[], sessionId: string) => {
+  const latest = new Map<string, FeedbackAssessment>();
+  for (const trace of traces) {
+    for (const assessment of trace.assessments ?? []) {
+      if (
+        !('feedback' in assessment) ||
+        assessment.valid === false ||
+        assessment.metadata?.[ASSESSMENT_SESSION_METADATA_KEY] !== sessionId
+      ) {
+        continue;
+      }
+      const key = JSON.stringify([
+        assessment.assessment_name,
+        assessment.source,
+        assessment.metadata?.['alignment_target_id'],
+      ]);
+      const previous = latest.get(key);
+      const recency = previous
+        ? Date.parse(assessment.last_update_time) - Date.parse(previous.last_update_time) ||
+          assessment.assessment_id.localeCompare(previous.assessment_id)
+        : 1;
+      if (recency > 0) latest.set(key, assessment);
+    }
+  }
+  return [...latest.values()];
+};
+
+const SessionComparisonPane = ({

+            <ExperimentSingleChatSessionSidebar
+              traces={traces}
+              selectedTurnIndex={selectedIndex < 0 ? null : selectedIndex}
+              setSelectedTurnIndex={() => {}}
+              setSelectedTrace={openTrace}

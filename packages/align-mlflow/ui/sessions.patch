+import { Tag, Tooltip, useDesignSystemTheme } from '@databricks/design-system';
+import {
+  getSessionDisplayName,
+  isClauseComplete,
+  type FilterClause,
+  type FilterFieldDef,
+  type TraceFilterModel,
+} from '@databricks/web-shared/traces-table';
+import type { ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+
+type Props = {
+  suggestions: ModelTraceInfoV3[];
+  fields: FilterFieldDef[];
+  model: TraceFilterModel;
+  onChange: (filters: TraceFilterModel) => void;
+};
+
+const TAG_LABELS = {
+  scenario_id: 'Scenario',
+  alignment_target_id: 'Target',
+  adm: 'ADM',
+  llm: 'LLM',
+  run: 'Run',
+  'align.run_key': 'Run',
+};
+
+const METADATA_LABELS = {
+  'mlflow.sourceRun': 'Run',
+  'mlflow.trace.session': 'Session',
+  'mlflow.trace.user': 'User',
+};
+
+const clauseLabel = (clause: FilterClause, fieldLabel: string) => {
+  if (clause.field === 'tag') {
+    return TAG_LABELS[clause.key as keyof typeof TAG_LABELS] || `${fieldLabel}: ${clause.key}`;
+  }
+  if (clause.field === 'metadata') {
+    return METADATA_LABELS[clause.key as keyof typeof METADATA_LABELS] || `${fieldLabel}: ${clause.key}`;
+  }
+  return clause.key ? `${fieldLabel}: ${clause.key}` : fieldLabel;
+};
+
+const clauseDisplayValue = (clause: FilterClause, traces: ModelTraceInfoV3[]) => {
+  if (clause.field === 'metadata' && clause.key === 'mlflow.sourceRun') {
+    return (
+      traces.find((trace) => trace.trace_metadata?.['mlflow.sourceRun'] === clause.value)?.tags?.['run'] || clause.value
+    );
+  }
+  if (clause.field === 'session' || (clause.field === 'metadata' && clause.key === 'mlflow.trace.session')) {
+    const trace = traces.find((candidate) => candidate.trace_metadata?.['mlflow.trace.session'] === clause.value);
+    return trace ? getSessionDisplayName(clause.value, trace) : clause.value;
+  }
+  const isState = clause.field === 'state';
+  if (isState && clause.value === 'IN_PROGRESS') return 'In progress';
+  if (isState && clause.value === 'ERROR') return 'Error';
+  return clause.value;
+};
+
+export const TracesV4FilterTags = ({ suggestions, fields, model: filters, onChange }: Props) => {
+  const { theme } = useDesignSystemTheme();
+  const active = filters.map((clause, index) => ({ clause, index })).filter(({ clause }) => isClauseComplete(clause));
+
+  if (!active.length) return null;
+  return (
+    <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.sm, minWidth: 0 }}>
+      <div
+        aria-label="Applied filters"
+        css={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: theme.spacing.sm, minWidth: 0 }}
+      >
+        {active.map(({ clause, index }) => {
+          const fieldLabel = fields.find((field) => field.id === clause.field)?.label || clause.field;
+          const label = clauseLabel(clause, fieldLabel);
+          const value = clauseDisplayValue(clause, suggestions);
+          const summary = `${label} ${clause.operator} ${value}`;
+          return (
+            <Tooltip
+              key={index}
+              componentId="mlflow.traces-v4.filters.applied-tooltip"
+              delayDuration={0}
+              content={
+                <div css={{ maxWidth: 360, overflowWrap: 'anywhere' }}>
+                  <strong>{label}</strong>
+                  <div>
+                    {clause.operator} {value}
+                  </div>
+                  {value !== clause.value && <div>Filter value: {clause.value}</div>}
+                </div>
+              }
+            >
+              <Tag
+                componentId="mlflow.traces-v4.filters.applied"
+                closable
+                tabIndex={0}
+                onClose={() => onChange(filters.filter((_, clauseIndex) => clauseIndex !== index))}
+                closeButtonProps={{ 'aria-label': `Remove ${label.toLowerCase()} filter` }}
+                css={{
+                  display: 'inline-flex',
+                  minWidth: 0,
+                  maxWidth: 'min(100%, 420px)',
+                  margin: 0,
+                  '& > span': { minWidth: 0, overflow: 'hidden' },
+                  '& button': { flexShrink: 0 },
+                }}
+              >
+                <span
+                  css={{
+                    display: 'block',
+                    overflow: 'hidden',
+                    textOverflow: 'ellipsis',
+                    whiteSpace: 'nowrap',
+                    minWidth: 0,
+                  }}
+                >
+                  {summary}
+                </span>
+              </Tag>
+            </Tooltip>
+          );
+        })}
+      </div>
+    </div>
+  );
+};

+import {
+  Button,
+  ChevronDownIcon,
+  FilterIcon,
+  Input,
+  Popover,
+  Tag,
+  Tooltip,
+  Typography,
+  useDesignSystemTheme,
+} from '@databricks/design-system';
+import { TableFilterItemTypeahead } from '../../../shared/web-shared/genai-traces-table/components/filters/TableFilterItemTypeahead';
+import type { OpenWorldEpisode } from './openWorldResultsData';
+
+type ResultsFiltersProps = {
+  episodes: OpenWorldEpisode[];
+  query: string;
+  run: string;
+  onChange: (key: string, value: string) => void;
+};
+
+type ActiveFiltersProps = ResultsFiltersProps & { onClear: () => void };
+
+const missingValue = '__missing__';
+const optionValue = (value: string) => value || missingValue;
+const recorded = (value: string) => (value === missingValue ? 'Unavailable' : value);
+
+export const OpenWorldResultsFilters = ({ episodes, query, run, onChange }: ResultsFiltersProps) => {
+  const { theme } = useDesignSystemTheme();
+  const invocationNames = new Map(episodes.map((episode) => [optionValue(episode.runId), episode.runName]));
+  const invocationLabel = (value: string) => {
+    const name = invocationNames.get(value);
+    return name ? `${name} (${recorded(value)})` : recorded(value);
+  };
+  const runOptions = [
+    { value: '', renderValue: () => 'All invocations' },
+    ...[...new Set([...invocationNames.keys(), ...(run ? [run] : [])])]
+      .sort((a, b) => invocationLabel(a).localeCompare(invocationLabel(b)))
+      .map((value) => ({ value, renderValue: () => invocationLabel(value) })),
+  ];
+  const count = [query, run].filter(Boolean).length;
+
+  return (
+    <Popover.Root componentId="mlflow.open-world.results.filters-popover">
+      <Popover.Trigger asChild>
+        <Button componentId="mlflow.open-world.results.filters" icon={<FilterIcon />} endIcon={<ChevronDownIcon />}>
+          Filter dashboard{count ? ` (${count})` : ''}
+        </Button>
+      </Popover.Trigger>
+      <Popover.Content align="end" css={{ padding: theme.spacing.md, width: 360, maxWidth: 'calc(100vw - 32px)' }}>
+        <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.md }}>
+          <label css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.xs }}>
+            <Typography.Text>Search results</Typography.Text>
+            <Input
+              componentId="mlflow.open-world.results.search"
+              aria-label="Search results"
+              placeholder="Scenario, target, ADM, model or run"
+              value={query}
+              onChange={(event) => onChange('resultsSearch', event.target.value)}
+            />
+          </label>
+          <div css={{ display: 'flex', flexDirection: 'column', gap: theme.spacing.xs }}>
+            <Typography.Text>Invocation</Typography.Text>
+            <TableFilterItemTypeahead
+              id="open-world-results-invocation"
+              ariaLabel="Invocation"
+              item={runOptions.find((option) => option.value === run)}
+              options={runOptions}
+              onChange={(value) => onChange('resultsRun', value)}
+              placeholder="All invocations"
+              width={328}
+              canSearchCustomValue={false}
+            />
+          </div>
+        </div>
+      </Popover.Content>
+    </Popover.Root>
+  );
+};
+
+export const OpenWorldResultsActiveFilters = ({ episodes, query, run, onChange, onClear }: ActiveFiltersProps) => {
+  const { theme } = useDesignSystemTheme();
+  const runName = episodes.find((episode) => optionValue(episode.runId) === run)?.runName;
+  const applied = [
+    { key: 'resultsSearch', label: 'Search', value: query, display: query, detail: '' },
+    {
+      key: 'resultsRun',
+      label: 'Invocation',
+      value: run,
+      display: runName || recorded(run),
+      detail: runName ? recorded(run) : '',
+    },
+  ].filter(({ value }) => Boolean(value));
+  if (!applied.length) return null;
+
+  return (
+    <div
+      aria-label="Active dashboard filters"
+      css={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: theme.spacing.sm, minWidth: 0 }}
+    >
+      {applied.map(({ key, label, display, detail }) => (
+        <Tooltip
+          key={key}
+          componentId="mlflow.open-world.results.applied-filter-tooltip"
+          delayDuration={0}
+          content={
+            <div css={{ maxWidth: 360, overflowWrap: 'anywhere' }}>
+              <strong>{label}</strong>
+              <div>{display}</div>
+              {detail && <div>Run ID: {detail}</div>}
+            </div>
+          }
+        >
+          <Tag
+            componentId="mlflow.open-world.results.applied-filter"
+            closable
+            tabIndex={0}
+            onClose={() => onChange(key, '')}
+            closeButtonProps={{ 'aria-label': `Remove ${label.toLowerCase()} filter` }}
+            css={{
+              display: 'inline-flex',
+              minWidth: 0,
+              maxWidth: 'min(100%, 420px)',
+              margin: 0,
+              '& > span': { minWidth: 0, overflow: 'hidden' },
+              '& button': { flexShrink: 0 },
+            }}
+          >
+            <span
+              css={{
+                display: 'block',
+                overflow: 'hidden',
+                textOverflow: 'ellipsis',
+                whiteSpace: 'nowrap',
+                minWidth: 0,
+              }}
+            >
+              {label}: {display}
+            </span>
+          </Tag>
+        </Tooltip>
+      ))}
+      <Button componentId="mlflow.open-world.results.clear-filters" type="tertiary" onClick={onClear}>
+        Clear filters
+      </Button>
+    </div>
+  );
+};

+  sortMode?: 'local' | 'provided';
+  runNames?: Readonly<Record<string, string>>;
+  columnOrder: string[];
+  onReorderColumn: (active: string, target: string) => void;
+  filters: {
+    fields: FilterFieldDef[];
+    model: TraceFilterModel;
+    onChange: (next: TraceFilterModel) => void;

+import { useMemo } from 'react';
+import type { ReactNode } from 'react';
+import type { ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+import {
+  countActiveFilters,
+  FilterOp,
+  TraceFilterButton,
+  type FilterClause,
+  type FilterFieldDef,
+  type TraceFilterModel,
+} from '@databricks/web-shared/traces-table';
+import { useMlflowTraceFilterFields } from '../utils/filterModel';
+import type { TagFilter } from '../hooks/useTracesV4UrlState';
+import { METADATA_COLUMN_PREFIX, TAG_COLUMN_PREFIX } from '../utils/customColumns';
+
+type ColumnFilter = { field: string; key?: string };
+
+const getColumnFilter = (id: string): ColumnFilter =>
+  id.startsWith(TAG_COLUMN_PREFIX)
+    ? { field: 'tag', key: id.slice(TAG_COLUMN_PREFIX.length) }
+    : id.startsWith(METADATA_COLUMN_PREFIX)
+      ? { field: 'metadata', key: id.slice(METADATA_COLUMN_PREFIX.length) }
+      : { field: id === 'tags' ? 'tag' : id };
+
+const matchesColumn = (clause: FilterClause, column: ColumnFilter) =>
+  clause.field === column.field && (column.key === undefined || clause.key === column.key);
+
+const matchesTag = (clause: FilterClause, tag: TagFilter) =>
+  clause.field === 'tag' && clause.key === tag.key && clause.operator === FilterOp.EQUALS && clause.value === tag.value;
+
+/** Both native filter entry points edit the same applied conditions, including tag links in the URL. */
+export const useTracesV4EditableFilters = ({
+  filterModel,
+  tagFilters,
+  setFilterModel,
+  setTagFilters,
+}: {
+  filterModel: TraceFilterModel;
+  tagFilters: TagFilter[];
+  setFilterModel: (next: TraceFilterModel) => void;
+  setTagFilters: (next: TagFilter[]) => void;
+}) => {
+  const filters = useMemo(
+    () => [
+      ...filterModel,
+      ...tagFilters
+        .filter((tag) => !filterModel.some((clause) => matchesTag(clause, tag)))
+        .map(({ key, value }) => ({ field: 'tag', key, value, operator: FilterOp.EQUALS })),
+    ],
+    [filterModel, tagFilters],
+  );
+  const onChange = (next: TraceFilterModel) => {
+    const retainedTags = tagFilters.filter((tag) => next.some((clause) => matchesTag(clause, tag)));
+    setFilterModel(next.filter((clause) => !retainedTags.some((tag) => matchesTag(clause, tag))));
+    if (retainedTags.length !== tagFilters.length) setTagFilters(retainedTags);
+  };
+  return { filters, onChange };
+};
+
+export const useTracesV4ColumnFilters = ({
+  columnIds,
+  fields,
+  filters,
+  onChange,
+  traces,
+}: {
+  columnIds: string[];
+  fields: FilterFieldDef[];
+  filters: TraceFilterModel;
+  onChange: (next: TraceFilterModel) => void;
+  traces: ModelTraceInfoV3[];
+}): Readonly<Partial<Record<string, ReactNode>>> => {
+  const definitions = useMemo(
+    () =>
+      columnIds.flatMap((id) => {
+        const column = getColumnFilter(id);
+        const baseField = fields.find((field) => field.id === column.field);
+        if (!baseField) return [];
+        const label = column.key ?? baseField.label;
+        const key = column.key;
+        const values = key
+          ? [
+              ...new Set(
+                traces.flatMap((trace) => {
+                  const value = (column.field === 'tag' ? trace.tags : trace.trace_metadata)?.[key];
+                  return value ? [value] : [];
+                }),
+              ),
+            ].sort()
+          : [];
+        const field: FilterFieldDef = values.length
+          ? { ...baseField, valueInput: 'combobox', options: values.map((value) => ({ value, label: value })) }
+          : baseField;
+        return [{ id, column, label, fields: [field] }];
+      }),
+    [columnIds, fields, traces],
+  );
+  return Object.fromEntries(
+    definitions.map(({ id, column, label, fields: columnFields }) => {
+      const scoped = filters.filter((clause) => matchesColumn(clause, column));
+      const replace = (next: TraceFilterModel) =>
+        onChange([...filters.filter((clause) => !matchesColumn(clause, column)), ...next]);
+      return [
+        id,
+        <TraceFilterButton
+          key={id}
+          column={{ label, key: column.key }}
+          fields={columnFields}
+          filterModel={scoped}
+          onChange={replace}
+          onClearAll={() => replace([])}
+          activeCount={countActiveFilters(scoped)}
+        />,
+      ];
+    }),
+  );
+};
+
+/** Uses the available cohort for suggestions independently of the currently displayed rows. */
+export const useTracesV4FilterFields = (traces: ModelTraceInfoV3[], assessmentNames?: string[]) => {
+  const names = useMemo(
+    () =>
+      assessmentNames ??
+      [
+        ...new Set(
+          traces.flatMap((trace) => (trace.assessments ?? []).map((assessment) => assessment.assessment_name)),
+        ),
+      ].sort(),
+    [traces, assessmentNames],
+  );
+  const fields = useMlflowTraceFilterFields(names);
+  return useMemo(() => {
+    const keys = {
+      tag: [...new Set(traces.flatMap((trace) => Object.keys(trace.tags ?? {})))].sort(),
+      metadata: [...new Set(traces.flatMap((trace) => Object.keys(trace.trace_metadata ?? {})))].sort(),
+    };
+    return fields.map((field) => {
+      if (field.id !== 'tag' && field.id !== 'metadata') return field;
+      return {
+        ...field,
+        keyInput: 'combobox' as const,
+        keyOptions: keys[field.id].map((key) => ({ value: key, label: key })),
+      };
+    });
+  }, [traces, fields]);
+};

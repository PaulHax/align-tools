+});
+
+const renderComparison = async (
+  current: ModelTraceInfoV3[],
+  other: ModelTraceInfoV3[],
+  allowOpenWorldCaseMatching = true,
+  openWorldComparisonContext?: OpenWorldComparisonContext,
+) => {
+  const entries = computeEvaluationsComparison(current.map(evaluation), other.map(evaluation));
+  const expandedSessions = new Set(
+    [...current, ...other].map((trace) => trace.trace_metadata?.[SESSION_ID_METADATA_KEY] ?? ''),
+  );

+    traces,
+    rowCount: pageRows.length,
+    totalRows: rows.length,
+    totalTraces: sorted.length,
+    hasStandaloneTraces: sorted.some((trace) => !trace.trace_metadata?.[SESSION_ID_METADATA_KEY]),
+    completeSessions: !needsSessionHydration || sessions.isComplete,
+    runNames: needsRunNames ? runNamesQuery.data : undefined,
+    isLoading:
+      enabled &&
+      (query.isLoading ||
+        (needsSessionHydration && !query.error && !sessions.error && !sessions.isComplete) ||
+        (needsRunNames && runNamesQuery.isLoading)),
+    isFetching:
+      enabled &&
+      (query.isFetching ||

+import { useMemo } from 'react';
+import { useQuery } from '@databricks/web-shared/query-client';
+import { SEARCH_MLFLOW_TRACES_QUERY_KEY } from '@databricks/web-shared/genai-traces-table';
+import {
+  SESSION_ID_METADATA_KEY,
+  type ModelTraceInfoV3,
+  type ModelTraceSearchLocation,
+} from '@databricks/web-shared/model-trace-explorer';
+import { fetchTracesV4SortPopulation } from '../utils/fetchTracesV4Population';
+
+type Props = {
+  locations: ModelTraceSearchLocation[];
+  seedTraces: ModelTraceInfoV3[];
+  seedVersion?: number;
+  enabled: boolean;
+};
+
+const EMPTY_TRACES: ModelTraceInfoV3[] = [];
+
+export const fetchTracesV4SessionPopulation = async (
+  locations: ModelTraceSearchLocation[],
+  seedTraces: ModelTraceInfoV3[],
+  signal?: AbortSignal,
+): Promise<ModelTraceInfoV3[]> => {
+  const sessionIds = [
+    ...new Set(seedTraces.flatMap((trace) => trace.trace_metadata?.[SESSION_ID_METADATA_KEY] || [])),
+  ].sort();
+  const traces = new Map(
+    seedTraces
+      .filter((trace) => !trace.trace_metadata?.[SESSION_ID_METADATA_KEY])
+      .map((trace) => [trace.trace_id, trace]),
+  );
+  let cursor = 0;
+  await Promise.all(
+    Array.from({ length: Math.min(6, sessionIds.length) }, async () => {
+      while (cursor < sessionIds.length) {
+        if (signal?.aborted) throw new DOMException('Session loading was cancelled', 'AbortError');
+        const sessionId = sessionIds[cursor++];
+        const filter = `request_metadata.\`${SESSION_ID_METADATA_KEY}\` = '${sessionId.replace(/'/g, "''")}'`;
+        const sessionTraces = await fetchTracesV4SortPopulation(locations, filter, signal);
+        for (const trace of sessionTraces) {
+          if (trace.trace_metadata?.[SESSION_ID_METADATA_KEY] === sessionId) traces.set(trace.trace_id, trace);
+        }
+      }
+    }),
+  );
+  return [...traces.values()];
+};
+
+/** Matching traces identify the sessions; their complete histories provide the displayed rows and aggregates. */
+export const useTracesV4SessionPopulation = ({ locations, seedTraces, seedVersion = 0, enabled }: Props) => {
+  const seedFingerprint = useMemo(
+    () => JSON.stringify([...seedTraces].sort((left, right) => left.trace_id.localeCompare(right.trace_id))),
+    [seedTraces],
+  );
+  const active = enabled && seedTraces.length > 0;
+  const query = useQuery({
+    queryKey: [SEARCH_MLFLOW_TRACES_QUERY_KEY, 'session-population', locations, seedFingerprint, seedVersion],
+    queryFn: ({ signal }) => fetchTracesV4SessionPopulation(locations, seedTraces, signal),

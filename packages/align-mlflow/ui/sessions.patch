+import { isValidElement, type ReactNode } from 'react';
+import MlflowUtils from '@databricks/web-shared/genai-traces-table/utils/MlflowUtils';
+import {
+  getAssessmentValue,
+  SESSION_ID_METADATA_KEY,
+  type ModelTraceInfoV3,
+} from '@databricks/web-shared/model-trace-explorer';
+import { getTraceCost, getTraceTokenUsage } from '@databricks/web-shared/model-trace-explorer/ModelTraceExplorer.utils';
+import { getTraceInfoInputs, getTraceInfoOutputs } from '@databricks/web-shared/genai-traces-table/utils/TraceUtils';
+import { getSessionDisplayName, type SortDirection } from '@databricks/web-shared/traces-table';
+import { parseDurationToMs } from '@databricks/web-shared/traces-table/formatTraceDuration';
+import { getSessionCost, getSessionDurationMs } from '@databricks/web-shared/traces-table/sessionAggregates';
+import {
+  assessmentNameFromColumnId,
+  extractTraceIssues,
+  isAssessmentColumnId,
+  pickCellAssessment,
+} from './assessmentColumns';
+import {
+  METADATA_COLUMN_PREFIX,
+  SESSION_SCORE_COLUMN_ID,
+  SESSION_TARGET_COLUMN_ID,
+  TAG_COLUMN_PREFIX,
+} from './customColumns';
+import { recordedSessionScore } from './sessionResults';
+
+export type MlflowTraceSortOptions = {
+  isGroupedBySession?: boolean;
+  sessionsMayBeIncomplete?: boolean;
+  runNames?: Readonly<Record<string, string>>;
+};
+
+type SortValue = string | number | undefined;
+const textOrder = new Intl.Collator('en', { sensitivity: 'base', numeric: false });
+const compareIds = (left: string, right: string) => (left < right ? -1 : left > right ? 1 : 0);
+const value = (candidate: unknown): SortValue =>
+  typeof candidate === 'number'
+    ? Number.isFinite(candidate)
+      ? candidate
+      : undefined
+    : typeof candidate === 'string' && candidate.trim()
+      ? candidate
+      : undefined;
+const time = (trace: ModelTraceInfoV3): SortValue => value(Date.parse(trace.request_time));
+const chronological = (left: ModelTraceInfoV3, right: ModelTraceInfoV3) =>
+  compareValues(time(left), time(right), 'asc') || compareIds(left.trace_id, right.trace_id);
+
+/** Missing values stay last in either direction; equal values use a separate stable identity tie-break. */
+const compareValues = (left: SortValue, right: SortValue, direction: SortDirection): number => {
+  if (left === undefined) return right === undefined ? 0 : 1;
+  if (right === undefined) return -1;
+  const compared =
+    typeof left === 'number' && typeof right === 'number'
+      ? left - right
+      : typeof left !== typeof right
+        ? typeof left === 'number'
+          ? -1
+          : 1
+        : textOrder.compare(String(left), String(right));
+  return direction === 'asc' ? compared : -compared;
+};
+
+const sourceText = (node: ReactNode): string => {
+  if (typeof node === 'string' || typeof node === 'number') return String(node);
+  if (Array.isArray(node)) return node.map(sourceText).join('');
+  return isValidElement<{ children?: ReactNode }>(node) ? sourceText(node.props.children) : '';
+};
+
+const dictionaryValue = (entries: Record<string, string> | undefined): SortValue =>
+  value(
+    Object.entries(entries ?? {})
+      .filter(([key]) => !key.startsWith('mlflow.'))
+      .sort(([left], [right]) => compareIds(left, right))
+      .map(([key, item]) => `${key}: ${item}`)
+      .join(', '),
+  );
+
+const distinctValues = (values: unknown[]): SortValue =>
+  value([...new Set(values.flatMap((item) => (typeof item === 'string' && item ? [item] : [])))].join(', '));
+
+export const getMlflowTraceSortValue = (
+  traces: ModelTraceInfoV3[],
+  column: string,
+  options: MlflowTraceSortOptions = {},
+): SortValue => {
+  const first = traces[0];
+  const last = traces.at(-1);
+  if (!first || !last) return undefined;
+  const grouped = options.isGroupedBySession && Boolean(first.trace_metadata?.[SESSION_ID_METADATA_KEY]);
+  if (column.startsWith(TAG_COLUMN_PREFIX)) {
+    const key = column.slice(TAG_COLUMN_PREFIX.length);
+    return grouped ? distinctValues(traces.map((trace) => trace.tags?.[key])) : value(first.tags?.[key]);
+  }
+  if (column.startsWith(METADATA_COLUMN_PREFIX)) {
+    const key = column.slice(METADATA_COLUMN_PREFIX.length);
+    return grouped
+      ? distinctValues(traces.map((trace) => trace.trace_metadata?.[key]))
+      : value(first.trace_metadata?.[key]);
+  }
+  if (column === SESSION_SCORE_COLUMN_ID || column === SESSION_TARGET_COLUMN_ID) {
+    const assessment = recordedSessionScore(traces);
+    return column === SESSION_SCORE_COLUMN_ID
+      ? value(assessment && getAssessmentValue(assessment))
+      : value(assessment?.metadata?.['alignment_target_id']);
+  }
+  if (isAssessmentColumnId(column)) {
+    const assessment = pickCellAssessment(
+      { ...first, assessments: traces.flatMap((trace) => trace.assessments ?? []) },
+      assessmentNameFromColumnId(column),
+    );
+    return assessment?.error ? undefined : value(assessment && getAssessmentValue(assessment));
+  }
+  switch (column) {
+    case 'trace_id':
+      return value(first.trace_id);
+    case 'trace_name':
+      return value(first.tags?.['mlflow.traceName']);
+    case 'start_time':
+      return time(first);
+    case 'input':
+      return value(getTraceInfoInputs(first));
+    case 'output':
+      return value(getTraceInfoOutputs(grouped ? last : first));
+    case 'user':
+      return value(first.trace_metadata?.['mlflow.trace.user'] || first.tags?.['mlflow.user']);
+    case 'session': {
+      const sessionId = first.trace_metadata?.[SESSION_ID_METADATA_KEY];
+      return sessionId ? getSessionDisplayName(sessionId, first) : undefined;
+    }
+    case 'duration':
+      return grouped
+        ? options.sessionsMayBeIncomplete
+          ? undefined
+          : getSessionDurationMs(traces)
+        : value(first.execution_duration ? parseDurationToMs(first.execution_duration) : undefined);
+    case 'state': {
+      const state = (grouped ? last : first).state;
+      return value(
+        state === 'ERROR' ? 'Error' : state === 'IN_PROGRESS' ? 'In progress' : state === 'OK' ? 'OK' : undefined,
+      );
+    }
+    case 'source':
+      return first.tags && first.trace_metadata?.[MlflowUtils.sourceTypeTag]
+        ? value(sourceText(MlflowUtils.renderSourceFromMetadata(first)))
+        : undefined;
+    case 'run_name': {
+      const runId = first.trace_metadata?.['mlflow.sourceRun'];
+      return value(
+        options.runNames !== undefined
+          ? runId
+            ? options.runNames[runId]
+            : undefined
+          : first.tags?.['mlflow.runName'] || first.tags?.['run'],
+      );
+    }
+    case 'tokens': {
+      if (grouped && options.sessionsMayBeIncomplete) return undefined;
+      const tokens = traces.flatMap((trace) => {
+        const total = getTraceTokenUsage(trace)?.total_tokens;
+        return typeof total === 'number' && Number.isFinite(total) ? [total] : [];
+      });
+      return tokens.length ? tokens.reduce((total, item) => total + item, 0) : undefined;
+    }
+    case 'cost':
+      return grouped
+        ? options.sessionsMayBeIncomplete
+          ? undefined
+          : getSessionCost(traces)
+        : value(getTraceCost(first)?.total_cost);
+    case 'tags':
+      return dictionaryValue(first.tags);
+    case 'metadata':
+      return dictionaryValue(first.trace_metadata);
+    case 'issues':
+      return value(
+        extractTraceIssues(first)
+          .map((issue) => issue.name)
+          .sort(textOrder.compare)
+          .join(', '),
+      );
+    default:
+      return undefined;
+  }
+};
+
+/** Sort a complete matching cohort before pagination; grouped sessions remain intact and chronological. */
+export const sortMlflowTraces = (
+  traces: ModelTraceInfoV3[],
+  column: string,
+  direction: SortDirection,
+  options: MlflowTraceSortOptions = {},
+): ModelTraceInfoV3[] => {
+  const groups = new Map<string, ModelTraceInfoV3[]>();
+  for (const trace of traces) {
+    const sessionId = options.isGroupedBySession ? trace.trace_metadata?.[SESSION_ID_METADATA_KEY] : undefined;
+    const key = sessionId ? `session:${sessionId}` : `trace:${trace.trace_id}`;
+    const members = groups.get(key);
+    if (members) members.push(trace);
+    else groups.set(key, [trace]);
+  }
+  return [...groups]
+    .map(([id, members]) => {
+      const ordered = [...members].sort(chronological);
+      return { id, traces: ordered, value: getMlflowTraceSortValue(ordered, column, options) };
+    })
+    .sort((left, right) => compareValues(left.value, right.value, direction) || compareIds(left.id, right.id))
+    .flatMap((group) => group.traces);
+};

+import type { ModelTraceInfoV3 } from '../model-trace-explorer/ModelTrace.types';
+
+export const getSessionDisplayName = (sessionId: string, trace?: Pick<ModelTraceInfoV3, 'tags'>): string => {
+  const tags = trace?.tags;
+  const run = tags?.['run']?.trim();
+  const scenario = tags?.['scenario_id']?.trim();
+  const episode = tags?.['episode']?.trim();
+  if (!tags?.['align.run_key'] || !run || !scenario || !episode) {
+    return sessionId;
+  }
+  const model = tags['llm']?.trim();
+  return [
+    run,
+    model && !run.includes(model) ? model : undefined,
+    scenario,
+    tags['alignment_target_id']?.trim() || 'unaligned',
+    `episode ${episode}`,
+  ]
+    .filter(Boolean)
+    .join(' | ');
+};

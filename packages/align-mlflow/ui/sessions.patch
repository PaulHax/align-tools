+export const ExperimentChatSessionComparison = ({
+  experimentId,
+  sessionIds,
+}: {
+  experimentId: string;
+  sessionIds: string[];
+}) => {
+  const { theme } = useDesignSystemTheme();
+  const [choices, setChoices] = useState<(SessionChoice | undefined)[]>([]);
+  const [compared, setCompared] = useState<{ sessionIds: string[]; traces: ModelTrace[] }>();
+  const selectionScope = JSON.stringify([experimentId, ...sessionIds]);
+  useEffect(() => {
+    setChoices([]);
+    setCompared(undefined);
+  }, [selectionScope]);
+  const selectDecision = useCallback((position: number, choice: SessionChoice | undefined) => {
+    setChoices((current) => {
+      if (current[position] === choice) return current;
+      const next = [...current];
+      next[position] = choice;
+      return next;
+    });
+  }, []);
+  const selectedTraces = sessionIds.flatMap((sessionId, index) => {
+    const choice = choices[index];
+    return choice?.sessionId === sessionId && choice.experimentId === experimentId ? [choice.trace] : [];
+  });
+  const canCompareDecisions = selectedTraces.length >= 2 && selectedTraces.length <= 3;
+  const currentComparison =
+    compared &&
+    compared.sessionIds.length === sessionIds.length &&
+    compared.sessionIds.every((id, index) => id === sessionIds[index]) &&
+    compared.traces.length === selectedTraces.length &&
+    compared.traces.every((trace, index) => trace === selectedTraces[index]);
+  if (sessionIds.length < 2 || sessionIds.some((id) => !id) || new Set(sessionIds).size !== sessionIds.length) {
+    return <div role="alert">Select at least two distinct sessions in the table.</div>;
+  }
+  return (
+    <ModelTraceExplorerPreferencesProvider>
+      <div
+        css={{ display: 'flex', flexDirection: 'column', flex: 1, minWidth: 0, minHeight: 0, gap: theme.spacing.sm }}
+      >
+        <div css={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: theme.spacing.sm }}>
+          <Typography.Text>
+            Each session keeps its own decision sequence. Choose decisions from two or three sessions to compare their
+            traces.
+          </Typography.Text>
+          <div role="status">
+            <Typography.Text>
+              {selectedTraces.length} decisions selected
+              {selectedTraces.length > 3 ? '. Clear a selection to compare at most three decisions.' : ''}
+            </Typography.Text>
+          </div>
+          <Button
+            componentId="mlflow.session-comparison.compare-decisions"
+            disabled={!canCompareDecisions}
+            onClick={() => setCompared({ sessionIds: [...sessionIds], traces: selectedTraces })}
+          >
+            Compare selected decisions
+          </Button>
+        </div>
+        <div
+          aria-label="Session comparison panes"
+          css={{
+            display: 'flex',
+            flex: 1,
+            minWidth: 0,
+            minHeight: 0,
+            gap: theme.spacing.md,
+            overflowX: 'auto',
+            overflowY: 'hidden',
+            paddingBottom: theme.spacing.sm,
+          }}
+        >
+          {sessionIds.map((sessionId, position) => (
+            <SessionComparisonPane
+              key={`${position}:${experimentId}:${sessionId}`}
+              experimentId={experimentId}
+              sessionId={sessionId}
+              position={position}
+              selected={choices[position]}
+              onSelect={selectDecision}
+            />
+          ))}
+        </div>
+      </div>
+      {compared && canCompareDecisions && currentComparison && (
+        <Drawer.Root open modal onOpenChange={(open) => !open && setCompared(undefined)}>
+          <Drawer.Content
+            componentId="mlflow.session-comparison.decision-drawer"
+            width="90vw"
+            title="Comparing selected decisions"
+            expandContentToFullHeight
+          >
+            <CompareModelTraceExplorer modelTraces={compared.traces} />
+          </Drawer.Content>
+        </Drawer.Root>
+      )}
+    </ModelTraceExplorerPreferencesProvider>
+  );
+};

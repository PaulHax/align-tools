+import type { ModelTraceInfoV3 } from '../model-trace-explorer/ModelTrace.types';
+import { getTraceCost } from '../model-trace-explorer/ModelTraceExplorer.utils';
+import { parseDurationToMs } from './formatTraceDuration';
+
+/** Elapsed time from the first start to the last completed trace in a complete session. */
+export const getSessionDurationMs = (traces: ModelTraceInfoV3[]): number | undefined => {
+  if (!traces.length) return undefined;
+  const intervals = traces.map((trace) => ({
+    start: Date.parse(trace.request_time),
+    duration: trace.execution_duration ? parseDurationToMs(trace.execution_duration) : null,
+  }));
+  if (intervals.some(({ start, duration }) => !Number.isFinite(start) || duration === null)) return undefined;
+  return (
+    Math.max(...intervals.map(({ start, duration }) => start + (duration ?? 0))) -
+    Math.min(...intervals.map(({ start }) => start))
+  );
+};
+
+/** Recorded cost totals across a complete session, unavailable when no trace records a cost. */
+export const getSessionCost = (traces: ModelTraceInfoV3[]): number | undefined => {
+  const costs = traces.flatMap((trace) => {
+    const cost = getTraceCost(trace)?.total_cost;
+    return typeof cost === 'number' && Number.isFinite(cost) ? [cost] : [];
+  });
+  return costs.length ? costs.reduce((total, cost) => total + cost, 0) : undefined;
+};

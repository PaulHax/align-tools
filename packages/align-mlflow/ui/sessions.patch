+import { describe, expect, jest, test } from '@jest/globals';
+import { screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { renderWithProviders } from '@databricks/web-shared/traces-table/test-utils/renderWithProviders';
+import { TracesV3Toolbar } from './TracesV3Toolbar';
+
+const mockClipboardCopy = jest.fn();
+jest.mock('use-clipboard-copy', () => ({
+  useClipboard: () => ({ copy: mockClipboardCopy }),
+}));
+
+describe('single-session title', () => {
+  test('displays a readable label while copying the persisted session ID', async () => {
+    const sessionId = 'scenario | target | unknown_adm profile run-1 | episode 1 | recorded-key';
+    const displayName = 'Recorded ADM profile run-1 | model-v1 | scenario | target | episode 1';
+    await renderWithProviders(
+      <TracesV3Toolbar viewState="single-chat-session" sessionId={sessionId} sessionDisplayName={displayName} />,
+    );
+    expect(screen.getByRole('heading', { name: displayName })).toHaveAttribute('title', sessionId);
+    await userEvent.click(screen.getByRole('button', { name: 'Copy' }));
+    expect(mockClipboardCopy).toHaveBeenCalledWith(sessionId);
+  });
+
+  test('retains the session ID when no display label is available', async () => {
+    await renderWithProviders(<TracesV3Toolbar viewState="single-chat-session" sessionId="original-session" />);
+    expect(screen.getByRole('heading', { name: 'original-session' })).toBeInTheDocument();
+  });
+});

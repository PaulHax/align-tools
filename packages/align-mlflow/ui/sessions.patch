+import { useCallback, useMemo, useState } from 'react';
+import type { ColumnSizingState } from '@tanstack/react-table';
+import type { ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+import {
+  TraceColumnSelector,
+  TracesTable,
+  type ColumnSelectorOption,
+  type SortDirection,
+  type TraceColumnId,
+} from '@databricks/web-shared/traces-table';
+import { useNavigate } from '../../../common/utils/RoutingUtils';
+import Routes from '../../routes';
+import { useTracesV4CustomColumns } from '../../components/experiment-page/components/traces-v4/hooks/useTracesV4CustomColumns';
+import {
+  SESSION_SCORE_COLUMN_ID,
+  SESSION_TARGET_COLUMN_ID,
+} from '../../components/experiment-page/components/traces-v4/utils/customColumns';
+import type { OpenWorldEpisode } from './openWorldResultsData';
+
+type Props = {
+  experimentId: string;
+  episodes: OpenWorldEpisode[];
+  preferences: ReturnType<typeof useOpenWorldResultsTablePreferences>;
+  selectedSessionIds: ReadonlySet<string>;
+  onToggleSession: (sessionId: string) => void;
+  onToggleAllSessions: () => void;
+};
+
+const STANDARD_COLUMNS: ColumnSelectorOption[] = [
+  { id: 'session', label: 'Session', componentId: 'mlflow.open-world.results.columns.session' },
+  { id: 'start_time', label: 'Start time', componentId: 'mlflow.open-world.results.columns.start-time' },
+];
+const DEFAULT_VISIBILITY = {
+  'tag:adm': true,
+  'tag:llm': true,
+  'tag:run': true,
+  'tag:scenario_id': true,
+  'tag:alignment_target_id': true,
+  [SESSION_SCORE_COLUMN_ID]: true,
+};
+const COLUMN_ORDER = ['session', 'start_time', ...Object.keys(DEFAULT_VISIBILITY)];
+
+export const useOpenWorldResultsTablePreferences = () => {
+  const [visibleColumns, setVisibleColumns] = useState<TraceColumnId[]>(['session', 'start_time']);
+  const [visibility, setVisibility] = useState<Record<string, boolean>>(DEFAULT_VISIBILITY);
+  const [columnSizing, setColumnSizing] = useState<ColumnSizingState>({});
+  const [sorting, setSorting] = useState<{ column: TraceColumnId; direction: SortDirection }>({
+    column: 'start_time',
+    direction: 'desc',
+  });
+  return {
+    visibleColumns,
+    setVisibleColumns,
+    visibility,
+    setVisibility,
+    columnSizing,
+    setColumnSizing,
+    sorting,
+    setSorting,
+  };
+};
+
+export const OpenWorldResultsSessions = ({
+  experimentId,
+  episodes,
+  preferences,
+  selectedSessionIds,
+  onToggleSession,
+  onToggleAllSessions,
+}: Props) => {
+  const navigate = useNavigate();
+  const {
+    visibleColumns,
+    setVisibleColumns,
+    visibility,
+    setVisibility,
+    columnSizing,
+    setColumnSizing,
+    sorting,
+    setSorting,
+  } = preferences;
+  const traces = useMemo(() => {
+    return episodes
+      .flatMap((episode) => episode.traces)
+      .sort((left, right) => {
+        const a = Date.parse(left.request_time);
+        const b = Date.parse(right.request_time);
+        if (!Number.isFinite(a) || !Number.isFinite(b)) {
+          return Number.isFinite(a) === Number.isFinite(b)
+            ? left.trace_id.localeCompare(right.trace_id)
+            : Number.isFinite(a)
+              ? -1
+              : 1;
+        }
+        return (sorting.direction === 'asc' ? a - b : b - a) || left.trace_id.localeCompare(right.trace_id);
+      });
+  }, [episodes, sorting]);
+  const selectedTraces = useMemo(
+    () =>
+      new Map(
+        traces
+          .filter((trace) => selectedSessionIds.has(trace.trace_metadata?.['mlflow.trace.session'] ?? ''))
+          .map((trace) => [trace.trace_id, trace]),
+      ),
+    [traces, selectedSessionIds],
+  );
+  const customColumns = useTracesV4CustomColumns(traces, visibility, setVisibility, true);
+  const columns = useMemo(
+    () => customColumns.columnDefs.filter(({ id }) => id !== SESSION_TARGET_COLUMN_ID),
+    [customColumns.columnDefs],
+  );
+  const visibleSessionIds = new Set(episodes.map((episode) => episode.sessionId).filter(Boolean));
+  const selectedCount = [...visibleSessionIds].filter((id) => selectedSessionIds.has(id)).length;
+  const getSessionHref = useCallback(
+    ({ sessionId }: { sessionId: string }) =>
+      Routes.getExperimentPageTabSingleChatSessionRoute(experimentId, sessionId),
+    [experimentId],
+  );
+  const openTrace = (trace: ModelTraceInfoV3) =>
+    navigate(
+      `${Routes.getExperimentPageTracesTabRoute(experimentId)}?${new URLSearchParams({ traceId: trace.trace_id })}`,
+    );
+  const toggleStandardColumn = (id: TraceColumnId) => {
+    setVisibleColumns((current) =>
+      current.includes(id) ? current.filter((column) => column !== id) : [...current, id],
+    );
+  };
+  return (
+    <div css={{ display: 'flex', flexDirection: 'column', gap: 12, minWidth: 0 }}>
+      <div css={{ alignSelf: 'flex-end' }}>
+        <TraceColumnSelector
+          columns={STANDARD_COLUMNS}
+          visibleColumns={visibleColumns}
+          onToggleColumn={toggleStandardColumn}
+          onResetToDefaults={() => {
+            setVisibleColumns(['session', 'start_time']);
+            setVisibility(DEFAULT_VISIBILITY);
+          }}
+          groups={[
+            {
+              label: 'Session results',
+              ...customColumns.sessions,
+              options: customColumns.sessions.selectorOptions.filter(({ id }) => id !== SESSION_TARGET_COLUMN_ID),
+              onToggle: customColumns.toggle,
+            },
+            {
+              label: 'Tags',
+              ...customColumns.tags,
+              options: customColumns.tags.selectorOptions,
+              onToggle: customColumns.toggle,
+            },
+            {
+              label: 'Metadata',
+              ...customColumns.metadata,
+              options: customColumns.metadata.selectorOptions,
+              onToggle: customColumns.toggle,
+            },
+          ]}
+        />
+      </div>
+      <TracesTable
+        traces={traces}
+        visibleColumns={visibleColumns}
+        extraColumns={columns}
+        columnOrder={COLUMN_ORDER}
+        initialColumnSizing={columnSizing}
+        onColumnSizingSettled={setColumnSizing}
+        isLoading={false}
+        isFetching={false}
+        skeletonRowCount={0}
+        onTraceSelected={openTrace}
+        selectedForBulk={selectedTraces}
+        isAllOnPageSelected={visibleSessionIds.size > 0 && selectedCount === visibleSessionIds.size}
+        isSomeOnPageSelected={selectedCount > 0 && selectedCount < visibleSessionIds.size}
+        onToggleBulkRow={(trace) => {
+          const sessionId = trace.trace_metadata?.['mlflow.trace.session'];
+          if (sessionId) onToggleSession(sessionId);
+        }}
+        selectedSessionIds={selectedSessionIds}
+        onToggleSessionSelection={onToggleSession}
+        onToggleBulkAll={onToggleAllSessions}
+        sort={sorting.column}
+        dir={sorting.direction}
+        onSort={(column, direction) => setSorting({ column, direction })}
+        getSessionHref={getSessionHref}
+        onSessionSelected={(session) => navigate(getSessionHref(session))}
+        onHideColumn={(id) => {
+          if (STANDARD_COLUMNS.some((column) => column.id === id)) {
+            setVisibleColumns((current) => current.filter((column) => column !== id));
+          } else {
+            setVisibility((current) => ({ ...current, [id]: false }));
+          }
+        }}
+        isGroupedBySession
+        sessionsMayBeIncomplete
+      />
+    </div>
+  );
+};

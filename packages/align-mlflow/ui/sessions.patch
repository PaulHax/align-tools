+import { useEffect, useState, type ReactNode } from 'react';
+import { Button, ChevronDownIcon, ChevronRightIcon, InfoIcon, Popover, Typography } from '@databricks/design-system';
+
+type SectionProps = {
+  title: string;
+  componentId: string;
+  help: ReactNode;
+  expanded: boolean;
+  onToggle: () => void;
+  children: ReactNode;
+};
+
+export const OpenWorldResultsSection = ({ title, componentId, help, expanded, onToggle, children }: SectionProps) => {
+  const [hasOpened, setHasOpened] = useState(expanded);
+  useEffect(() => {
+    if (expanded) setHasOpened(true);
+  }, [expanded]);
+  const contentId = `${componentId}.content`;
+  const titleId = `${componentId}.title`;
+  return (
+    <section aria-labelledby={titleId} css={{ minWidth: 0, flexShrink: 0 }}>
+      <div css={{ display: 'flex', alignItems: 'center', gap: 4 }}>
+        <Typography.Title id={titleId} level={3} withoutMargins css={{ fontSize: 16 }}>
+          <Button
+            componentId={`${componentId}.toggle`}
+            type="tertiary"
+            aria-label={title}
+            aria-expanded={expanded}
+            aria-controls={contentId}
+            icon={expanded ? <ChevronDownIcon /> : <ChevronRightIcon />}
+            onClick={onToggle}
+            css={{
+              '&&': {
+                height: 'auto !important',
+                minHeight: 0,
+                padding: '0 !important',
+                border: 'none !important',
+                color: 'inherit',
+                font: 'inherit',
+                lineHeight: 'inherit',
+                textAlign: 'left',
+                justifyContent: 'flex-start',
+              },
+            }}
+          >
+            {title}
+          </Button>
+        </Typography.Title>
+        <Popover.Root componentId={`${componentId}.help`}>
+          <Popover.Trigger asChild>
+            <Button
+              componentId={`${componentId}.help-trigger`}
+              type="tertiary"
+              size="small"
+              icon={<InfoIcon />}
+              aria-label={`About ${title}`}
+            />
+          </Popover.Trigger>
+          <Popover.Content align="start" css={{ maxWidth: 380 }}>
+            <Typography.Paragraph withoutMargins>{help}</Typography.Paragraph>
+          </Popover.Content>
+        </Popover.Root>
+      </div>
+      <div id={contentId} hidden={!expanded} css={{ paddingTop: 8 }}>
+        {(expanded || hasOpened) && children}
+      </div>
+    </section>
+  );
+};

+import {
+  SESSION_ID_METADATA_KEY,
+  getAssessmentValue,
+  type Assessment,
+  type ModelTraceInfoV3,
+} from '@databricks/web-shared/model-trace-explorer';
+import { SESSION_SCORE_COLUMN_ID } from './customColumns';
+
+const SCORE_NAME = 'ta3_session_alignment_score';
+
+const recordedSessionScore = (traces: ModelTraceInfoV3[]): Assessment | undefined => {
+  const sessionId = traces[0]?.trace_metadata?.[SESSION_ID_METADATA_KEY];
+  if (!sessionId) {
+    return undefined;
+  }
+  return traces
+    .flatMap((trace) => trace.assessments ?? [])
+    .reduce<Assessment | undefined>((latest, assessment) => {
+      const value = getAssessmentValue(assessment);
+      if (
+        assessment.assessment_name !== SCORE_NAME ||
+        assessment.valid === false ||
+        !('feedback' in assessment) ||
+        assessment.source?.source_type !== 'CODE' ||
+        assessment.source?.source_id !== 'raw_align_system.log' ||
+        typeof value !== 'number' ||
+        !Number.isFinite(value) ||
+        assessment.metadata?.[SESSION_ID_METADATA_KEY] !== sessionId
+      ) {
+        return latest;
+      }
+      const updated = Date.parse(assessment.last_update_time ?? assessment.create_time ?? '') || 0;
+      const previousUpdated = Date.parse(latest?.last_update_time ?? latest?.create_time ?? '') || 0;
+      return latest &&
+        (previousUpdated > updated ||
+          (previousUpdated === updated && (latest.assessment_id ?? '') >= (assessment.assessment_id ?? '')))
+        ? latest
+        : assessment;
+    }, undefined);
+};
+
+/** Recorded episode feedback remains valid even when only part of its session is on the page. */
+export const renderSessionResult = (traces: ModelTraceInfoV3[], columnId: string) => {
+  const assessment = recordedSessionScore(traces);
+  const value = assessment && getAssessmentValue(assessment);
+  const text =
+    columnId === SESSION_SCORE_COLUMN_ID
+      ? typeof value === 'number' && Number.isFinite(value)
+        ? String(value)
+        : 'Unavailable'
+      : assessment?.metadata?.['alignment_target_id'] || 'Unavailable';
+  return <span title={assessment?.rationale || undefined}>{text}</span>;
+};

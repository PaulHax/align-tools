+import { useEffect, useState, type KeyboardEvent } from 'react';
+import { Global } from '@emotion/react';
+import { Button, Tooltip, Typography, useDesignSystemTheme } from '@databricks/design-system';
+import { aggregateEpisodes, groupEpisodes, type OpenWorldEpisode } from './openWorldResultsData';
+import { OpenWorldResultsSectionTitle } from './OpenWorldResultsHelp';
+import { OpenWorldRunIdentity } from './OpenWorldRunIdentity';
+
+type ResultsChartsProps = {
+  episodes: OpenWorldEpisode[];
+  onSelectEpisodes: (episodes: OpenWorldEpisode[]) => void;
+};
+
+const recorded = (value: string) => value || 'Unavailable';
+const label = (episode: OpenWorldEpisode) =>
+  `${recorded(episode.adm)} / ${recorded(episode.model)} · ${recorded(episode.runName)} [${recorded(episode.runId)}]`;
+const provenance = (episode: OpenWorldEpisode) =>
+  [
+    episode.sourceFamily && `source family ${episode.sourceFamily}`,
+    `source revision ${recorded(episode.sourceVersion)}`,
+    `driver ${recorded(episode.driver)}`,
+    episode.scoringVersion && `scoring ${episode.scoringVersion}`,
+  ]
+    .filter(Boolean)
+    .join(', ');
+const formatScore = (score: number) => Number(score.toPrecision(4)).toString();
+const pointSpacing = 24;
+const ticks = [0, 0.25, 0.5, 0.75, 1];
+const outOfRange = (score: number) => score < 0 || score > 1;
+const plottedScore = (score: number) => Math.max(0, Math.min(1, score));
+const x = (score: number) => 24 + plottedScore(score) * 552;
+const rangeContext = (score: number): [string, string][] =>
+  outOfRange(score) ? [['Range', `Outside 0 to 1; plotted at ${plottedScore(score)}`]] : [];
+
+const ChartTooltipContent = ({ title, rows, hint }: { title: string; rows: [string, string][]; hint: string }) => (
+  <div css={{ padding: '6px 4px', minWidth: 220 }}>
+    <div css={{ fontSize: 20, fontWeight: 600, marginBottom: 10 }}>{title}</div>
+    <dl css={{ display: 'grid', gridTemplateColumns: 'max-content minmax(0, 1fr)', gap: '4px 14px', margin: 0 }}>
+      {rows.map(([name, value]) => (
+        <div key={name} css={{ display: 'contents' }}>
+          <dt css={{ opacity: 0.75 }}>{name}</dt>
+          <dd css={{ margin: 0, fontWeight: 500, overflowWrap: 'anywhere' }}>{value}</dd>
+        </div>
+      ))}
+    </dl>
+    <div css={{ marginTop: 10, fontSize: 12, opacity: 0.8 }}>{hint}</div>
+  </div>
+);
+
+export const OpenWorldResultsCharts = ({ episodes, onSelectEpisodes }: ResultsChartsProps) => {
+  const { theme } = useDesignSystemTheme();

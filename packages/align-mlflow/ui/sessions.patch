+    refetch: () => {
+      void query.refetch();
+      if (needsRunNames) void runNamesQuery.refetch();
+    },
+    dataUpdatedAt: query.dataUpdatedAt,
+    hasNext: pageIndex * pageSize < rows.length,
+    hasPrev: pageIndex > 1,
+    goToPage,
+  };
+};

+  });
+  const error = search.error || queries.find((query) => query.error)?.error;
+  const isLoading = loadingInfos || queries.some((query) => query.isLoading || query.isFetching);
+  const traces = queries.flatMap((query) => (query.data ? [query.data] : []));
+  const complete = !isLoading && !error && traces.length === infos.length;
+  const selectedIndex =

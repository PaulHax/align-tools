+import { describe, expect, test } from '@jest/globals';
+import type { ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+import { aggregateEpisodes, buildOpenWorldEpisodes, filterEpisodes, groupEpisodes } from './openWorldResultsData';
+
+const trace = (id: string, session: string, score?: number, target = 'a'): ModelTraceInfoV3 =>
+  ({
+    trace_id: id,
+    trace_location: { type: 'MLFLOW_EXPERIMENT', mlflow_experiment: { experiment_id: '1' } },
+    request_time: '2026-01-01T00:00:00Z',
+    state: 'OK',
+    trace_metadata: { 'mlflow.trace.session': session, 'mlflow.sourceRun': 'run-1' },
+    tags: {
+      step: '1',
+      'align.import_complete': 'source-record-v1',
+      scenario_id: 'scenario',
+      alignment_target_id: target,
+    },
+    assessments:
+      score === undefined
+        ? []
+        : [
+            {
+              assessment_id: id,
+              trace_id: id,
+              create_time: '2026-01-01T00:00:00Z',
+              last_update_time: '2026-01-01T00:00:00Z',
+              assessment_name: 'ta3_session_alignment_score',
+              source: { source_type: 'CODE', source_id: 'raw_align_system.log' },
+              feedback: { value: score },
+              metadata: { 'mlflow.trace.session': session, alignment_target_id: 'a' },
+            },
+          ],
+  }) as ModelTraceInfoV3;
+
+describe('Open World episode population', () => {
+  test('counts each session once and preserves missing scores and metadata conflicts', () => {
+    const episodes = buildOpenWorldEpisodes([
+      trace('1', 'one', 0),
+      trace('2', 'one', undefined, 'b'),
+      trace('3', 'two'),
+    ]);
+    expect(episodes).toHaveLength(2);
+    expect(episodes[0].metadataConflicts).toContain('target');
+    expect(aggregateEpisodes(episodes)).toMatchObject({ total: 2, scored: 1, missing: 1, mean: 0 });
+    expect(groupEpisodes(episodes, ['scenario'])[0].episodes).toEqual(episodes);
+  });
+
+  test('rejects invalid feedback and chooses the most recent valid persisted score', () => {
+    const first = trace('1', 'one', 0.25);
+    const second = trace('2', 'one', 0.75, 'b');
+    first.assessments![0].last_update_time = '2026-01-01T00:00:00Z';
+    second.assessments![0].last_update_time = '2026-02-01T00:00:00Z';
+    const invalid = trace('3', 'one', 1);
+    invalid.assessments![0].valid = false;
+    expect(buildOpenWorldEpisodes([invalid, second, first])[0].score).toBe(0.75);
+    expect(buildOpenWorldEpisodes([trace('4', 'two', Number.NaN)])[0].score).toBeUndefined();
+  });
+
+  test('retains unscored cases in coverage while macro means use only scored cases', () => {
+    const episodes = buildOpenWorldEpisodes([
+      trace('1', 'one', 0),
+      trace('2', 'two', undefined),
+      trace('3', 'three', 1, 'b'),
+      trace('4', 'four', undefined, 'c'),
+    ]);
+    expect(aggregateEpisodes(episodes, 'equal-case')).toMatchObject({ total: 4, scored: 2, missing: 2, mean: 0.5 });
+    expect(groupEpisodes(episodes, ['scenario', 'target'])).toHaveLength(3);
+    const unscored = groupEpisodes(episodes, ['scenario', 'target']).find((group) => group.episodes[0].target === 'c');
+    expect(unscored).toMatchObject({ total: 1, scored: 0, missing: 1, mean: undefined });
+    expect(
+      episodes.every(
+        (episode) => episode.sourceVersion === '' && episode.sourceFamily === '' && episode.scoringVersion === '',
+      ),
+    ).toBe(true);
+  });
+
+  test('keeps pooled and equal-case weighting explicit and filters the entire population', () => {
+    const episodes = buildOpenWorldEpisodes([trace('1', 'one', 0), trace('2', 'two', 0), trace('3', 'three', 1, 'b')]);
+    expect(aggregateEpisodes(episodes).mean).toBeCloseTo(1 / 3);
+    expect(aggregateEpisodes(episodes, 'equal-case').mean).toBe(0.5);
+    expect(filterEpisodes(episodes, { target: 'b' }).map((episode) => episode.id)).toEqual(['three']);
+    expect(aggregateEpisodes([]).mean).toBeUndefined();

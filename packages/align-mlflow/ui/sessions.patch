+import { Button } from '@databricks/design-system';
+import { useNavigate } from '../../../common/utils/RoutingUtils';
+import Routes from '../../routes';
+import { TRACE_V4_SHARE_URL_PARAM_KEY } from '../../components/experiment-page/components/traces-v4/utils/tracesV4SavedViewState';
+
+export const SESSION_COMPARISON_QUERY_PARAM = 'compareSessionId';
+
+export const getSessionSelectionRoute = (experimentId: string) => {
+  const params = new URLSearchParams({
+    startTimeLabel: 'ALL',
+    groupBy: 'session',
+    [TRACE_V4_SHARE_URL_PARAM_KEY]: 'open-world-adm-performance',
+  });
+  return `${Routes.getExperimentPageTracesTabRoute(experimentId)}?${params.toString()}`;
+};
+
+export const getSessionComparisonRoute = (experimentId: string, sessionIds: string[]) => {
+  const uniqueIds = [...new Set(sessionIds.filter(Boolean))];
+  if (uniqueIds.length < 2) return getSessionSelectionRoute(experimentId);
+  const params = new URLSearchParams();
+  uniqueIds.slice(1).forEach((sessionId) => params.append(SESSION_COMPARISON_QUERY_PARAM, sessionId));
+  return `${Routes.getExperimentPageTabSingleChatSessionRoute(experimentId, uniqueIds[0])}?${params.toString()}`;
+};
+
+export const CompareSessionsButton = ({ experimentId }: { experimentId: string }) => {
+  const navigate = useNavigate();
+  return (
+    <Button
+      componentId="mlflow.open-world.select-sessions-in-table"
+      onClick={() => navigate(getSessionSelectionRoute(experimentId))}
+    >
+      Select sessions in table
+    </Button>
+  );
+};

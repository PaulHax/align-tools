+import { createTraceLocationForExperiment } from '@databricks/web-shared/genai-traces-table';
+import { useQuery } from '../../../common/utils/reactQueryHooks';
+import type { ModelTraceInfoV3 } from '@databricks/web-shared/model-trace-explorer';
+import { fetchAPI, getAjaxUrl } from '../../../shared/web-shared/model-trace-explorer/ModelTraceExplorer.request.utils';
+import { buildOpenWorldEpisodes } from './openWorldResultsData';
+
+export const fetchOpenWorldEpisodes = async (experimentId: string, signal?: AbortSignal) => {
+  const traces: ModelTraceInfoV3[] = [];
+  const tokens = new Set<string>();
+  let token: string | undefined;
+  do {
+    const response = (await fetchAPI(
+      getAjaxUrl('ajax-api/3.0/mlflow/traces/search'),
+      'POST',
+      {
+        locations: [createTraceLocationForExperiment(experimentId)],
+        filter: "tags.step = '1' AND tags.`align.import_complete` = 'source-record-v1'",
+        max_results: 500,
+        order_by: ['timestamp ASC'],
+        ...(token ? { page_token: token } : {}),
+      },
+      signal,
+    )) as { traces?: ModelTraceInfoV3[]; next_page_token?: string; error_code?: string; message?: string };
+    if (response.error_code) throw new Error(response.message || response.error_code);
+    if (response.traces !== undefined && !Array.isArray(response.traces)) {
+      throw new Error('Episode search returned an invalid response');
+    }
+    traces.push(...(response.traces ?? []));
+    token = response.next_page_token || undefined;
+    if (token && tokens.has(token)) throw new Error('Episode search repeated a page token');
+    if (token) tokens.add(token);
+  } while (token);
+  return buildOpenWorldEpisodes(traces);
+};
+
+export const useOpenWorldEpisodes = ({ experimentId }: { experimentId: string }) => {
+  const query = useQuery({
+    queryKey: ['open-world-episodes', experimentId],
+    queryFn: ({ signal }) => fetchOpenWorldEpisodes(experimentId, signal),
+    enabled: Boolean(experimentId),
+    retry: false,
+    staleTime: 0,
+    refetchOnMount: true,
+    refetchOnWindowFocus: true,
+  });
+  return {
+    episodes: query.data ?? [],
+    dataUpdatedAt: query.dataUpdatedAt,
+    isLoading: query.isLoading,
+    isRefreshing: query.isFetching && !query.isLoading,
+    error: query.error,
+    refetch: query.refetch,
+  };
+};

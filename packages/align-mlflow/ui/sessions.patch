+import { useMemo, type ReactNode } from 'react';
+import { Button, Typography, useDesignSystemTheme } from '@databricks/design-system';
+import type { ModelTraceSearchLocation } from '../../model-trace-explorer/ModelTrace.types';
+import { useQuery } from '../../query-client/queryClient';
+import { createMlflowSearchFilter, searchMlflowTracesQueryFn } from '../hooks/useMlflowTraces';
+import { FilterOperator, TracesTableColumnGroup, type TableFilter } from '../types';
+import { TableFilterItemTypeahead } from './filters/TableFilterItemTypeahead';
+
+export const OPEN_WORLD_TAG_COLUMNS = [
+  { key: 'scenario_id', label: 'Scenario' },
+  { key: 'alignment_target_id', label: 'Alignment target' },
+  { key: 'adm', label: 'ADM' },
+  { key: 'llm', label: 'Model' },
+  { key: 'run', label: 'Run' },
+  { key: 'align.run_key', label: 'Run' },
+  { key: 'align.source_version', label: 'Source version' },
+];
+
+export const getOpenWorldFilterValue = (filters: TableFilter[], key: string) =>
+  filters
+    .find(
+      (filter) =>
+        filter.column === TracesTableColumnGroup.TAG && filter.key === key && filter.operator === FilterOperator.EQUALS,
+    )
+    ?.value?.toString();
+
+export const setOpenWorldFilterValue = (
+  filters: TableFilter[],
+  key: string,
+  value: string | undefined,
+): TableFilter[] => [
+  ...filters.filter((filter) => filter.column !== TracesTableColumnGroup.TAG || filter.key !== key),
+  ...(value ? [{ column: TracesTableColumnGroup.TAG, key, operator: FilterOperator.EQUALS, value }] : []),
+];
+
+export const useOpenWorldEpisodeMetadata = ({
+  locations,
+  runUuids,
+}: {
+  locations: ModelTraceSearchLocation[];
+  runUuids?: string[];
+}) => {
+  const scope = [...new Set(runUuids?.filter(Boolean) ?? [])].sort();
+  return useQuery({
+    queryKey: ['open-world-trace-filter-options', locations, scope],
+    queryFn: async ({ signal }) => {
+      const results = await Promise.all(
+        (scope.length ? scope : [undefined]).map((runUuid) =>
+          searchMlflowTracesQueryFn({
+            signal,
+            locations,
+            filter: createMlflowSearchFilter(runUuid, undefined, [
+              { column: TracesTableColumnGroup.TAG, key: 'step', operator: FilterOperator.EQUALS, value: '1' },
+            ]),
+            limit: Infinity,
+          }),
+        ),
+      );
+      return results.flat();
+    },
+    refetchOnWindowFocus: false,
+  });
+};
+
+/** Episode metadata is constant across its actions, so the first action is sufficient for complete options. */
+export const OpenWorldTraceFilters = ({
+  locations,
+  runUuids,
+  scenario,
+  alignmentTarget,
+  onScenarioChange,
+  onAlignmentTargetChange,
+  getFilterValue,
+  onFilterChange,
+  onResetFilters,
+  children,
+}: {
+  locations: ModelTraceSearchLocation[];
+  runUuids?: string[];
+  scenario?: string;
+  alignmentTarget?: string;
+  onScenarioChange: (value: string | undefined) => void;
+  onAlignmentTargetChange: (value: string | undefined) => void;
+  getFilterValue?: (key: string) => string | undefined;
+  onFilterChange?: (key: string, value: string | undefined) => void;
+  onResetFilters?: () => void;
+  children?: ReactNode;
+}) => {
+  const { theme } = useDesignSystemTheme();
+  const { data, isLoading, error, refetch } = useOpenWorldEpisodeMetadata({ locations, runUuids });
+  const optionKeys = OPEN_WORLD_TAG_COLUMNS.map(({ key }) => key);
+  const optionsByKey = useMemo(
+    () =>
+      Object.fromEntries(
+        OPEN_WORLD_TAG_COLUMNS.map(({ key }) => [
+          key,
+          [...new Set(data?.flatMap((trace) => (trace.tags?.[key] ? [trace.tags[key]] : [])) ?? [])].sort(),
+        ]),
+      ),
+    [data],
+  );
+
+  const scenarios = optionsByKey['scenario_id'];
+  const targets = optionsByKey['alignment_target_id'];
+  const hasFilters = Boolean(scenario || alignmentTarget || optionKeys.some((key) => getFilterValue?.(key)));
+
+  if (!isLoading && !error && !scenarios.length && !targets.length && !hasFilters) {
+    return <>{children}</>;
+  }
+
+  const renderSelector = (
+    label: string,
+    values: string[],
+    value: string | undefined,
+    onChange: (value: string | undefined) => void,
+    key = label === 'Scenario' ? 'scenario_id' : 'alignment_target_id',
+  ) => {
+    const allLabel =
+      label === 'Scenario'
+        ? 'All scenarios'
+        : label === 'Alignment target'
+          ? 'All alignment targets'
+          : `All ${label === 'LLM' ? 'models' : label.toLowerCase() + 's'}`;
+    const options = [
+      { value: '', renderValue: () => allLabel },
+      ...[...new Set([...values, ...(value ? [value] : [])])].sort().map((item) => ({
+        value: item,
+        renderValue: () => {
+          const runName =
+            key === 'align.run_key' ? data?.find((trace) => trace.tags?.[key] === item)?.tags?.['run'] : undefined;
+          return runName ? `${runName} (${item})` : item;
+        },
+      })),
+    ];
+    return (
+      <div css={{ display: 'flex', alignItems: 'center', gap: theme.spacing.xs }}>
+        <Typography.Text>{label}</Typography.Text>
+        <TableFilterItemTypeahead
+          ariaLabel={label}
+          id={`open-world-${key.replaceAll('.', '-')}`}
+          item={options.find((option) => option.value === (value ?? ''))}
+          query={{ data: options, isLoading }}
+          onChange={(next) => onChange(next || undefined)}
+          placeholder={allLabel}
+          width={220}
+          canSearchCustomValue={false}
+        />
+      </div>
+    );
+  };
+
+  return (
+    <div
+      css={{
+        display: 'flex',
+        alignItems: 'center',
+        flexWrap: 'wrap',
+        gap: theme.spacing.sm,
+        paddingBottom: theme.spacing.sm,
+      }}
+    >
+      {renderSelector('Scenario', scenarios, scenario, onScenarioChange)}
+      {renderSelector('Alignment target', targets, alignmentTarget, onAlignmentTargetChange)}
+      {onFilterChange &&
+        OPEN_WORLD_TAG_COLUMNS.filter(({ key }) => !['scenario_id', 'alignment_target_id', 'run'].includes(key)).map(
+          ({ key, label }) => (
+            <div key={key}>
+              {renderSelector(
+                label === 'Model' ? 'LLM' : label,
+                optionsByKey[key],
+                getFilterValue?.(key),
+                (value) => onFilterChange(key, value),
+                key,
+              )}
+            </div>
+          ),
+        )}
+      {onResetFilters && hasFilters && (
+        <Button componentId="mlflow.open-world.reset-filters" onClick={onResetFilters}>
+          Reset episode filters
+        </Button>
+      )}
+      {isLoading && <span role="status">Loading all scenario and alignment target options…</span>}
+      {error ? (
+        <div role="alert">
+          Could not load all scenario and alignment target options.{' '}
+          <Button componentId="mlflow.open-world.retry-episode-filters" onClick={() => refetch()}>
+            Retry
+          </Button>
+        </div>
+      ) : null}
+      {children}
+    </div>
+  );
+};

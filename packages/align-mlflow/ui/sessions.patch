+/* eslint-disable jsx-a11y/no-noninteractive-tabindex -- The named horizontal plot scroller is a keyboard entry point. */
+import { useEffect, useState, type KeyboardEvent } from 'react';
+import { Global } from '@emotion/react';
+import { Button, Tooltip, Typography, useDesignSystemTheme } from '@databricks/design-system';
+import {
+  aggregateEpisodes,
+  episodeCaseKey,
+  groupEpisodes,
+  requestedTargetLabel,
+  type OpenWorldEpisode,
+} from './openWorldResultsData';
+import { getRunDisplayName, OpenWorldRunIdentity } from './OpenWorldRunIdentity';
+import { useDynamicPlotSize } from '../../components/runs-charts/components/RunsCharts.common';
+
+type ResultsChartsProps = {
+  episodes: OpenWorldEpisode[];
+  onSelectEpisodes: (episodes: OpenWorldEpisode[]) => void;
+};
+
+const recorded = (value: string) => value || 'Unavailable';
+const label = (episode: OpenWorldEpisode) =>
+  `${recorded(episode.adm)} / ${recorded(episode.model)} · ${recorded(episode.runName)}`;
+const formatScore = (score: number) => Number(score.toPrecision(4)).toString();
+const runIdentityLineStyle = {
+  display: 'block',
+  width: '100%',
+  minWidth: 0,
+  overflow: 'hidden',
+  textOverflow: 'ellipsis',
+  whiteSpace: 'nowrap',
+  fontSize: '12px !important',
+  lineHeight: '16px !important',
+} as const;
+const pointSpacing = 20;
+const minimumPlotWidth = 420;
+const horizontalMarkerSpacing = 22;
+const plotColumns = `minmax(180px, 260px) minmax(${minimumPlotWidth}px, 1fr)`;
+const ticks = [0, 0.25, 0.5, 0.75, 1];
+const outOfRange = (score: number) => score < 0 || score > 1;
+const plottedScore = (score: number) => Math.max(0, Math.min(1, score));
+const scorePosition = (score: number, width: number) => 24 + plottedScore(score) * (width - 48);
+const rangeContext = (score: number): [string, string][] =>
+  outOfRange(score) ? [['Range', `Outside 0 to 1; plotted at ${plottedScore(score)}`]] : [];
+
+const ChartTooltipContent = ({ title, rows, hint }: { title: string; rows: [string, string][]; hint: string }) => (
+  <div css={{ padding: '6px 4px', minWidth: 200 }}>
+    <div css={{ fontSize: 16, fontWeight: 600, marginBottom: 6 }}>{title}</div>
+    <dl css={{ display: 'grid', gridTemplateColumns: 'max-content minmax(0, 1fr)', gap: '2px 12px', margin: 0 }}>
+      {rows.map(([name, value]) => (
+        <div key={name} css={{ display: 'contents' }}>
+          <dt css={{ opacity: 0.75 }}>{name}</dt>
+          <dd css={{ margin: 0, fontWeight: 500, overflowWrap: 'anywhere' }}>{value}</dd>
+        </div>
+      ))}
+    </dl>
+    <div css={{ marginTop: 6, fontSize: 12, opacity: 0.8 }}>{hint}</div>
+  </div>
+);

# ITM example: copy to .env and adjust paths, port, and both allowlists as needed.
# Port 5001 allows testing while the existing server uses 5000.
MLFLOW_BACKEND_STORE_URI=sqlite:////data/shared/mlflow/mlflow.db
MLFLOW_ARTIFACTS_DESTINATION=/data/shared/mlflow/artifacts
MLFLOW_DEFAULT_ARTIFACT_ROOT=mlflow-artifacts:/
MLFLOW_SERVE_ARTIFACTS=true
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5001
MLFLOW_WORKERS=1
MLFLOW_SERVER_ALLOWED_HOSTS=10.50.57.47:5001,itm.khq.kitware.com:5001,localhost:5001
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://10.50.57.47:5001,http://itm.khq.kitware.com:5001,http://localhost:5001
